<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>GAIA report &ndash; {{ sample }}</title>
  <link rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
        crossorigin="anonymous"/>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"
          integrity="sha384-3hr+MFI1GBqiRkwfIiBlMH2wgFpKsVcBIi5FiLLnGBH25q/b1yx7sxkBNbJlBAC"
          crossorigin="anonymous"></script>
  <style>
    body { background: #f8f9fa; }
    .navbar-brand { font-weight: 700; letter-spacing: .05em; }
    canvas { background: #fff; border-radius: .25rem; padding: .5rem; }
  </style>
</head>
<body>
<nav class="navbar navbar-dark bg-dark mb-4">
  <div class="container-fluid">
    <span class="navbar-brand">&#129747; GAIA &mdash; Metagenomics Pipeline Report</span>
  </div>
</nav>
<div class="container pb-5">

  {# ── Pipeline information ───────────────────────────────────────────── #}
  <div class="card mb-4 shadow-sm">
    <div class="card-header fw-semibold">&#x2139;&#xFE0F; Pipeline information</div>
    <div class="card-body">
      <dl class="row mb-0">
        <dt class="col-sm-3">Sample</dt>
        <dd class="col-sm-9"><code>{{ sample }}</code></dd>
        <dt class="col-sm-3">Pipeline mode</dt>
        <dd class="col-sm-9">
          {% if run_mode == "profiling_only" %}
            <span class="badge bg-info">Profiling only</span>
          {% elif run_mode == "assembly_binning_only" %}
            <span class="badge bg-warning text-dark">Assembly &amp; Binning</span>
          {% else %}
            <span class="badge bg-success">Both</span>
          {% endif %}
        </dd>
        <dt class="col-sm-3">Generated</dt>
        <dd class="col-sm-9">{{ generated_at }}</dd>
      </dl>
    </div>
  </div>

  {# ── Taxonomy – top species ─────────────────────────────────────────── #}
  {% if kraken2_species or centrifuger_species %}
  <div class="card mb-4 shadow-sm">
    <div class="card-header fw-semibold">&#x1F52C; Taxonomy &ndash; top species per classifier</div>
    <div class="card-body">

      {% if kraken2_species %}
      {% set top_pct = kraken2_species | sum(attribute='percent') %}
      <h6 class="mt-2">
        Kraken2 &ndash; top {{ kraken2_species | length }} species
        <small class="text-muted ms-2">(top-{{ kraken2_species | length }} account for {{ "%.1f" | format(top_pct) }}% of all reads)</small>
      </h6>
      <canvas id="chart_kraken2" style="max-height:320px;"></canvas>
      <script>
      (function(){
        var ctx = document.getElementById('chart_kraken2').getContext('2d');
        new Chart(ctx, {
          type: 'bar',
          data: {
            labels: {{ kraken2_species | map(attribute='name') | list | tojson }},
            datasets: [{
              label: 'Reads',
              data: {{ kraken2_species | map(attribute='reads') | list | tojson }},
              backgroundColor: 'rgba(54, 162, 235, 0.75)',
              borderColor: 'rgba(54, 162, 235, 0.75)',
              borderWidth: 1
            }]
          },
          options: {
            indexAxis: 'y',
            responsive: true,
            plugins: {
              legend: { display: false },
              tooltip: {
                callbacks: {
                  label: function(context) {
                    var pct = {{ kraken2_species | map(attribute='percent') | list | tojson }}[context.dataIndex];
                    return 'Reads: ' + context.parsed.x.toLocaleString() + ' (' + pct + '%)';
                  }
                }
              }
            },
            scales: { x: { beginAtZero: true } }
          }
        });
      })();
      </script>
      <div class="table-responsive mt-3">
        <table class="table table-sm table-striped table-hover align-middle">
          <thead class="table-dark"><tr><th>Species</th><th>Reads</th><th>% of total</th></tr></thead>
          <tbody>
            {% for row in kraken2_species %}
            <tr><td>{{ row.name }}</td><td>{{ row.reads | int }}</td><td>{{ row.percent }}</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% endif %}

      {% if centrifuger_species %}
      {% set top_pct = centrifuger_species | sum(attribute='percent') %}
      <h6 class="mt-4">
        Centrifuger &ndash; top {{ centrifuger_species | length }} species
        <small class="text-muted ms-2">(top-{{ centrifuger_species | length }} total abundance: {{ "%.4f" | format(top_pct) }})</small>
      </h6>
      <canvas id="chart_centrifuger" style="max-height:320px;"></canvas>
      <script>
      (function(){
        var ctx = document.getElementById('chart_centrifuger').getContext('2d');
        new Chart(ctx, {
          type: 'bar',
          data: {
            labels: {{ centrifuger_species | map(attribute='name') | list | tojson }},
            datasets: [{
              label: 'Reads',
              data: {{ centrifuger_species | map(attribute='reads') | list | tojson }},
              backgroundColor: 'rgba(255, 159, 64, 0.75)',
              borderColor: 'rgba(255, 159, 64, 0.75)',
              borderWidth: 1
            }]
          },
          options: {
            indexAxis: 'y',
            responsive: true,
            plugins: {
              legend: { display: false },
              tooltip: {
                callbacks: {
                  label: function(context) {
                    var pct = {{ centrifuger_species | map(attribute='percent') | list | tojson }}[context.dataIndex];
                    return 'Reads: ' + context.parsed.x.toLocaleString() + ' (' + pct + '%)';
                  }
                }
              }
            },
            scales: { x: { beginAtZero: true } }
          }
        });
      })();
      </script>
      <div class="table-responsive mt-3">
        <table class="table table-sm table-striped table-hover align-middle">
          <thead class="table-dark"><tr><th>Species</th><th>Reads</th><th>Abundance (%)</th></tr></thead>
          <tbody>
            {% for row in centrifuger_species %}
            <tr><td>{{ row.name }}</td><td>{{ row.reads | int }}</td><td>{{ row.percent }}</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% endif %}

    </div>
  </div>
  {% endif %}

  {# ── Genome summary ─────────────────────────────────────────────────── #}
  {% if genome_summary %}
  <div class="card mb-4 shadow-sm">
    <div class="card-header fw-semibold">&#x1F9EC; Genome summary</div>
    <div class="card-body">
      <div class="table-responsive">
        <table class="table table-sm table-striped table-hover align-middle">
          <thead class="table-dark">
            <tr>{% for col in genome_summary[0].keys() %}<th>{{ col }}</th>{% endfor %}</tr>
          </thead>
          <tbody>
            {% for row in genome_summary %}
            <tr>{% for val in row.values() %}<td>{{ val }}</td>{% endfor %}</tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </div>
  {% endif %}

  {# ── Genome inventory ───────────────────────────────────────────────── #}
  {% if genome_inventory %}
  <div class="card mb-4 shadow-sm">
    <div class="card-header fw-semibold">&#x1F4E6; Genome inventory</div>
    <div class="card-body">
      <div class="table-responsive">
        <table class="table table-sm table-striped table-hover align-middle">
          <thead class="table-dark">
            <tr>{% for col in genome_inventory[0].keys() %}<th>{{ col }}</th>{% endfor %}</tr>
          </thead>
          <tbody>
            {% for row in genome_inventory %}
            <tr>{% for val in row.values() %}<td>{{ val }}</td>{% endfor %}</tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </div>
  {% endif %}

  {# ── Combined pipeline summary ──────────────────────────────────────── #}
  {% if pipeline_summary %}
  <div class="card mb-4 shadow-sm">
    <div class="card-header fw-semibold">&#x1F4CA; Combined pipeline summary</div>
    <div class="card-body">
      <div class="table-responsive">
        <table class="table table-sm table-striped table-hover align-middle">
          <thead class="table-dark">
            <tr>{% for col in pipeline_summary[0].keys() %}<th>{{ col }}</th>{% endfor %}</tr>
          </thead>
          <tbody>
            {% for row in pipeline_summary %}
            <tr>{% for val in row.values() %}<td>{{ val }}</td>{% endfor %}</tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </div>
  {% endif %}

</div>
</body>
</html>
