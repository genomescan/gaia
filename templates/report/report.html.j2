<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>Gaia report – {{ sample }}</title>
  <link rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
        crossorigin="anonymous"/>
  <script src="https://cdn.plot.ly/plotly-2.27.0.min.js" crossorigin="anonymous"></script>
  <style>
    :root {
      --gs-primary: #00a7cf;
      --gs-dark: #111166;
      --gs-bg: #f5f7fb;
    }
    body { background: var(--gs-bg); font-family: Verdana, Geneva, sans-serif; }
    .report-wrap { max-width: 1200px; margin: 0 auto; padding: 1.25rem; }
    .report-title { color: var(--gs-dark); font-weight: 700; }
    .card { border: 0; box-shadow: 0 .125rem .5rem rgba(0,0,0,.08); }
    .card-header { background: var(--gs-primary); color: #fff; font-weight: 600; }
    .meta-label { color: #6c757d; font-size: .9rem; }
    .plot { width: 100%; height: 320px; }
  </style>
</head>
<body>
<div class="report-wrap">
  <div class="d-flex justify-content-between align-items-start mb-3 gap-3 flex-wrap">
    <div>
      <h1 class="h3 report-title mb-1">Gaia metagenomics report</h1>
      <div class="text-muted">Sample <code>{{ sample }}</code></div>
    </div>
    <div class="text-end">
      <div class="meta-label">Pipeline mode</div>
      <div><strong>{{ run_mode }}</strong></div>
      <div class="meta-label mt-2">Generated</div>
      <div>{{ generated_at }}</div>
    </div>
  </div>

  {% if workflow_image %}
  <div class="card mb-4">
    <div class="card-header">Pipeline overview</div>
    <div class="card-body text-center">
      <img src="{{ workflow_image }}" alt="Pipeline workflow" class="img-fluid rounded"/>
    </div>
  </div>
  {% endif %}

  <div class="card mb-4">
    <div class="card-header">Preprocessing</div>
    <div class="card-body">
      <div class="row g-3">
        <div class="col-md-6"><span class="meta-label">Preprocessing</span><div>{{ "Enabled" if preprocessing_enabled else "Skipped" }}</div></div>
        <div class="col-md-6"><span class="meta-label">Host removal</span><div>{{ "Enabled" if host_removal_enabled else "Disabled" }}</div></div>
        {% if preprocessing_enabled %}
          <div class="col-md-6"><span class="meta-label">Filtering method</span><div>{{ filtering_method }}</div></div>
          {% if filtering_method == "chopper" %}
            <div class="col-md-6"><span class="meta-label">Chopper settings</span><div>Min length {{ chopper_min_length }} bp, quality Q{{ chopper_quality }}</div></div>
          {% else %}
            <div class="col-md-6"><span class="meta-label">Filtlong settings</span><div>Min length {{ filtlong_min_length }} bp, keep {{ filtlong_keep_percent }}%</div></div>
          {% endif %}
        {% endif %}
        {% if host_ref %}
          <div class="col-12"><span class="meta-label">Host reference</span><div><code>{{ host_ref }}</code></div></div>
        {% endif %}
      </div>
    </div>
  </div>

  {% if host_stats and host_plot_data %}
  <div class="card mb-4">
    <div class="card-header">Host removal summary</div>
    <div class="card-body">
      <div id="host-removal-plot" class="plot"></div>
      <div class="table-responsive mt-3">
        <table class="table table-sm table-striped align-middle">
          <thead><tr><th>Read category</th><th>Count</th><th>Percentage</th></tr></thead>
          <tbody>
            <tr><td>Host</td><td>{{ host_stats.host_reads | int }}</td><td>{{ host_stats.host_percentage }}%</td></tr>
            <tr><td>Non-host</td><td>{{ host_stats.non_host_reads | int }}</td><td>{{ host_stats.non_host_percentage }}%</td></tr>
            <tr class="fw-semibold"><td>Total</td><td>{{ host_stats.total_reads | int }}</td><td>100%</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  {% endif %}

  {% if versions %}
  <div class="card mb-4">
    <div class="card-header">Tool versions (from metadata/versions.json)</div>
    <div class="card-body">
      <div class="table-responsive">
        <table class="table table-sm table-striped align-middle">
          <thead><tr><th>Tool</th><th>Version</th></tr></thead>
          <tbody>
          {% for tool, ver in versions.items() %}
            <tr><td><code>{{ tool }}</code></td><td>{{ ver }}</td></tr>
          {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </div>
  {% endif %}

  {% if kraken2_species or centrifuger_species %}
  <div class="card mb-4">
    <div class="card-header">Taxonomy highlights</div>
    <div class="card-body">
      {% if kraken2_species %}
      <h2 class="h6">Kraken2 top species</h2>
      <div id="kraken2-plot" class="plot"></div>
      {% endif %}
      {% if centrifuger_species %}
      <h2 class="h6 mt-4">Centrifuger top species</h2>
      <div id="centrifuger-plot" class="plot"></div>
      {% endif %}
    </div>
  </div>
  {% endif %}

  {% if genome_summary %}
  <div class="card mb-4">
    <div class="card-header">Genome summary</div>
    <div class="card-body">
      <div class="table-responsive">
        <table class="table table-sm table-striped align-middle">
          <thead><tr>{% for col in genome_summary[0].keys() %}<th>{{ col }}</th>{% endfor %}</tr></thead>
          <tbody>{% for row in genome_summary %}<tr>{% for val in row.values() %}<td>{{ val }}</td>{% endfor %}</tr>{% endfor %}</tbody>
        </table>
      </div>
    </div>
  </div>
  {% endif %}

  {% if genome_inventory %}
  <div class="card mb-4">
    <div class="card-header">Genome inventory</div>
    <div class="card-body">
      <div class="table-responsive">
        <table class="table table-sm table-striped align-middle">
          <thead><tr>{% for col in genome_inventory[0].keys() %}<th>{{ col }}</th>{% endfor %}</tr></thead>
          <tbody>{% for row in genome_inventory %}<tr>{% for val in row.values() %}<td>{{ val }}</td>{% endfor %}</tr>{% endfor %}</tbody>
        </table>
      </div>
    </div>
  </div>
  {% endif %}

  {% if pipeline_summary %}
  <div class="card mb-4">
    <div class="card-header">Pipeline summary</div>
    <div class="card-body">
      <div class="table-responsive">
        <table class="table table-sm table-striped align-middle">
          <thead><tr>{% for col in pipeline_summary[0].keys() %}<th>{{ col }}</th>{% endfor %}</tr></thead>
          <tbody>{% for row in pipeline_summary %}<tr>{% for val in row.values() %}<td>{{ val }}</td>{% endfor %}</tr>{% endfor %}</tbody>
        </table>
      </div>
    </div>
  </div>
  {% endif %}
</div>

<script>
  const hostPlotData = {{ host_plot_data | default('null') | safe }};
  const kraken2Species = {{ kraken2_species | tojson }};
  const centrifugerSpecies = {{ centrifuger_species | tojson }};

  function renderHorizontalBar(containerId, rows, barColor) {
    if (!rows || rows.length === 0) return;
    Plotly.newPlot(containerId, [{
      type: 'bar',
      orientation: 'h',
      x: rows.map(r => Number(r.reads || 0)),
      y: rows.map(r => r.name),
      marker: {color: barColor},
      hovertemplate: '%{y}<br>Reads: %{x:,}<extra></extra>'
    }], {
      margin: {l: 220, r: 20, t: 10, b: 40},
      height: 320,
      xaxis: {title: 'Reads'}
    }, {responsive: true, displayModeBar: false});
  }

  if (hostPlotData) {
    Plotly.newPlot('host-removal-plot', [{
      type: 'pie',
      labels: hostPlotData.labels,
      values: hostPlotData.values,
      hole: 0.45,
      marker: {colors: ['#111166', '#00a7cf']},
      hovertemplate: '%{label}: %{value:,} (%{percent})<extra></extra>'
    }], {margin: {l: 20, r: 20, t: 10, b: 10}}, {responsive: true, displayModeBar: false});
  }

  renderHorizontalBar('kraken2-plot', kraken2Species, '#00a7cf');
  renderHorizontalBar('centrifuger-plot', centrifugerSpecies, '#111166');
</script>
</body>
</html>
