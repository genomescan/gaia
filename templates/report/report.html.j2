<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>Gaia run report</title>
  <link rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
        crossorigin="anonymous"/>
  {{ plotly_js }}
  <style>
    :root {
      --nv-navy: #10164f;
      --nv-navy-soft: #1a236f;
      --nv-cyan: #19b6d4;
      --nv-cyan-soft: #dff6fb;
      --nv-bg: #f4f7fb;
      --nv-card: #ffffff;
      --nv-text: #1d2840;
      --nv-muted: #67748b;
      --nv-border: #d9e3f0;
      --nv-shadow: 0 18px 45px rgba(16, 22, 79, 0.10);
      --nv-radius: 22px;
    }

    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: linear-gradient(180deg, #eef4fb 0%, var(--nv-bg) 180px);
      color: var(--nv-text);
      font-family: "Segoe UI", Arial, sans-serif;
    }

    .page {
      max-width: 1560px;
      margin: 0 auto;
      padding: 24px;
    }

    .layout {
      display: grid;
      grid-template-columns: 260px minmax(0, 1fr);
      gap: 18px;
      align-items: start;
    }

    .sidebar {
      position: sticky;
      top: 14px;
      background: var(--nv-card);
      border: 1px solid var(--nv-border);
      border-radius: 18px;
      box-shadow: var(--nv-shadow);
      padding: 14px;
      max-height: calc(100vh - 28px);
      overflow: auto;
    }

    .sidebar summary {
      cursor: pointer;
      font-weight: 700;
      color: var(--nv-navy);
      margin-bottom: 10px;
    }

    .sample-jump-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 8px;
    }

    .sample-jump-list a {
      display: block;
      padding: 8px 10px;
      border-radius: 10px;
      text-decoration: none;
      color: var(--nv-navy);
      background: #f8fbff;
      border: 1px solid var(--nv-border);
    }

    .sample-jump-list a:hover {
      background: var(--nv-cyan-soft);
    }

    .hero {
      background: linear-gradient(135deg, var(--nv-navy) 0%, var(--nv-navy-soft) 55%, #26339c 100%);
      color: #fff;
      border-radius: 28px;
      padding: 28px 30px;
      box-shadow: var(--nv-shadow);
      overflow: hidden;
      position: relative;
    }

    .hero::after {
      content: "";
      position: absolute;
      inset: 0;
      background:
        radial-gradient(circle at top right, rgba(255,255,255,0.20), transparent 30%),
        radial-gradient(circle at bottom left, rgba(25,182,212,0.22), transparent 30%);
      pointer-events: none;
    }

    .hero-top,
    .hero-stats,
    .overview-grid,
    .sample-header,
    .metrics-grid,
    .content-grid {
      display: grid;
      gap: 16px;
    }

    .hero-top {
      grid-template-columns: minmax(0, 1.8fr) minmax(280px, 1fr);
      align-items: end;
      position: relative;
      z-index: 1;
    }

    .brand-chip,
    .tag,
    .sample-tab {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      border-radius: 999px;
      font-weight: 600;
    }

    .brand-chip {
      background: rgba(255,255,255,0.12);
      border: 1px solid rgba(255,255,255,0.18);
      color: #fff;
      padding: 10px 14px;
      margin-bottom: 16px;
      letter-spacing: 0.02em;
    }

    .hero h1 {
      margin: 0 0 10px;
      font-size: clamp(2rem, 3vw, 3rem);
      font-weight: 700;
    }

    .hero p,
    .hero code {
      color: rgba(255,255,255,0.92);
    }

    .hero-summary {
      max-width: 720px;
      line-height: 1.5;
      margin-bottom: 0;
    }

    .hero-stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      position: relative;
      z-index: 1;
    }

    .stat-card,
    .panel,
    .metric,
    .section-card {
      background: var(--nv-card);
      border-radius: var(--nv-radius);
      box-shadow: var(--nv-shadow);
    }

    .stat-card {
      background: rgba(255,255,255,0.12);
      border: 1px solid rgba(255,255,255,0.18);
      padding: 16px 18px;
      min-height: 98px;
    }

    .stat-label {
      font-size: 0.75rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.78);
      margin-bottom: 6px;
    }

    .stat-value {
      font-size: 1.3rem;
      font-weight: 700;
      word-break: break-word;
    }

    .overview-grid {
      grid-template-columns: minmax(260px, 360px) minmax(0, 1fr);
      margin-top: 22px;
      align-items: start;
    }

    .panel {
      padding: 22px;
      border: 1px solid var(--nv-border);
    }

    .panel-title,
    .section-title {
      margin: 0 0 12px;
      color: var(--nv-navy);
      font-weight: 700;
    }

    .panel-subtitle,
    .muted {
      color: var(--nv-muted);
    }

    .tag-list,
    .sample-tabs {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .tag,
    .sample-tab {
      background: var(--nv-cyan-soft);
      color: var(--nv-navy);
      border: 1px solid rgba(25,182,212,0.20);
      padding: 8px 12px;
      text-decoration: none;
    }

    .sample-tab {
      background: #fff;
      box-shadow: 0 10px 22px rgba(16, 22, 79, 0.08);
    }

    .workflow-card img {
      width: 100%;
      border-radius: 18px;
      border: 1px solid var(--nv-border);
      background: #fff;
    }

    /* Interactive workflow diagram (inline SVG, see report.html.j2 +
       render_report.py WORKFLOW_NODES/WORKFLOW_EDGES for the underlying
       data). Hover/focus a tool node to reveal its tooltip. */
    .workflow-legend {
      margin-bottom: 14px;
    }

    .workflow-legend .tag {
      display: inline-flex;
      align-items: center;
      gap: 7px;
    }

    .workflow-legend .legend-swatch {
      width: 11px;
      height: 11px;
      border-radius: 50%;
      flex: 0 0 auto;
      display: inline-block;
    }

    .workflow-svg-wrap {
      width: 100%;
      border-radius: 18px;
      border: 1px solid var(--nv-border);
      background: #fff;
      padding: 6px;
    }

    .workflow-svg {
      width: 100%;
      height: auto;
      display: block;
    }

    .wf-edge {
      fill: none;
      stroke-width: 3;
      stroke-linecap: round;
      opacity: 0.55;
    }

    .wf-node {
      cursor: pointer;
    }

    .wf-node circle.wf-hit {
      fill: transparent;
    }

    .wf-node circle.wf-dot {
      stroke-width: 3;
      fill: #fff;
      transition: filter 0.15s ease, stroke-width 0.15s ease;
    }

    .wf-node:hover circle.wf-dot,
    .wf-node:focus circle.wf-dot,
    .wf-node:focus-visible circle.wf-dot {
      stroke-width: 4;
      filter: drop-shadow(0 2px 6px rgba(16, 22, 79, 0.35));
    }

    .wf-node:focus {
      outline: none;
    }

    .wf-label {
      font-size: 12px;
      fill: var(--nv-text);
      text-anchor: middle;
      pointer-events: none;
    }

    .wf-tooltip {
      display: none;
      background: var(--nv-navy);
      color: #fff;
      font-size: 0.78rem;
      font-weight: 400;
      line-height: 1.45;
      padding: 8px 12px;
      border-radius: 10px;
      box-shadow: 0 4px 18px rgba(16, 22, 79, 0.22);
      pointer-events: none;
    }

    .wf-tooltip strong {
      display: block;
      margin-bottom: 3px;
      color: #fff;
    }

    .wf-node:hover .wf-tooltip,
    .wf-node:focus .wf-tooltip,
    .wf-node:focus-visible .wf-tooltip {
      display: block;
    }

    .sample-nav {
      margin: 26px 0 18px;
    }

    .sample-report {
      margin-top: 28px;
    }

    .sample-header {
      grid-template-columns: minmax(0, 1.4fr) minmax(260px, 0.8fr);
      align-items: start;
      margin-bottom: 16px;
    }

    .sample-banner {
      background: linear-gradient(135deg, var(--nv-navy) 0%, #22308a 100%);
      color: #fff;
      border-radius: 24px;
      padding: 24px 26px;
      box-shadow: var(--nv-shadow);
    }

    .sample-banner h2 {
      margin: 0 0 8px;
      font-size: 1.8rem;
    }

    .sample-banner code {
      color: #fff;
      background: rgba(255,255,255,0.08);
      border-radius: 10px;
      padding: 2px 8px;
    }

    .metrics-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .metric {
      padding: 16px 18px;
      border: 1px solid var(--nv-border);
    }

    .metric .stat-label {
      color: var(--nv-muted);
    }

    .metric .stat-value {
      color: var(--nv-navy);
      font-size: 1rem;
    }

    .content-grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      margin-top: 18px;
    }

    .section-card {
      padding: 22px;
      border: 1px solid var(--nv-border);
      grid-column: span 12;
    }

    .section-card.split {
      grid-column: span 6;
    }

    .section-kicker {
      display: inline-block;
      margin-bottom: 8px;
      font-size: 0.75rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--nv-cyan);
      font-weight: 700;
    }

    .meta-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 14px;
    }

    .meta-item {
      padding: 14px;
      border-radius: 16px;
      background: #f8fbff;
      border: 1px solid var(--nv-border);
    }

    .meta-item strong {
      display: block;
      color: var(--nv-muted);
      font-size: 0.85rem;
      margin-bottom: 4px;
      font-weight: 600;
    }

    .plot {
      width: 100%;
      min-height: 320px;
    }

    .table {
      margin-bottom: 0;
      --bs-table-bg: transparent;
    }

    .table thead th {
      color: var(--nv-navy);
      background: #f6fbff;
      border-bottom-width: 1px;
      font-size: 0.85rem;
    }

    .table td,
    .table th {
      vertical-align: middle;
      border-color: var(--nv-border);
    }

    .empty-state {
      padding: 18px;
      border-radius: 18px;
      background: #f8fbff;
      color: var(--nv-muted);
      border: 1px dashed var(--nv-border);
    }

    /* Tooltip help icon */
    .help-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background: var(--nv-cyan-soft);
      border: 1px solid rgba(25,182,212,0.35);
      color: var(--nv-navy);
      font-size: 0.68rem;
      font-weight: 700;
      cursor: default;
      position: relative;
      top: -1px;
      margin-left: 7px;
      vertical-align: middle;
      user-select: none;
    }

    .help-icon .help-tooltip {
      display: none;
      position: absolute;
      left: 50%;
      bottom: calc(100% + 6px);
      transform: translateX(-50%);
      background: var(--nv-navy);
      color: #fff;
      font-size: 0.78rem;
      font-weight: 400;
      line-height: 1.45;
      padding: 8px 12px;
      border-radius: 10px;
      white-space: normal;
      width: 240px;
      z-index: 999;
      box-shadow: 0 4px 18px rgba(16,22,79,0.22);
      pointer-events: none;
    }

    .help-icon:hover .help-tooltip {
      display: block;
    }

    @media (max-width: 1080px) {
      .layout {
        grid-template-columns: 1fr;
      }
      .sidebar {
        position: static;
        max-height: none;
      }
      .hero-top,
      .overview-grid,
      .sample-header {
        grid-template-columns: 1fr;
      }

      .section-card.split {
        grid-column: span 12;
      }
    }

    @media (max-width: 768px) {
      .page {
        padding: 14px;
      }

      .hero,
      .sample-banner,
      .panel,
      .section-card {
        padding: 18px;
      }

      .hero-stats,
      .metrics-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>
<div class="page">
  <div class="layout">
    <aside class="sidebar">
      <details>
        <summary>Sample navigator ({{ samples_data | length }})</summary>
        <ul class="sample-jump-list">
          {% for sd in samples_data %}
          <li><a href="#sample-{{ loop.index }}">Sample {{ sd.sample }}</a></li>
          {% endfor %}
        </ul>
      </details>
    </aside>
    <main>
  <header class="hero">
    <div class="hero-top">
      <div>
        <div class="brand-chip">Gaia &middot; analysis pipeline for long-read shotgun metagenomics</div>
        <h1>Metagenomics run report</h1>
        <p class="hero-summary">
          A consolidated overview of preprocessing, host removal, taxonomic profiling, and genome
          reconstruction (assembly and binning, summarized across all samples) for
          <code>{{ samples | length }}</code> sample(s).
        </p>
      </div>
      <div class="hero-stats">
        <div class="stat-card">
          <div class="stat-label">Run mode</div>
          <div class="stat-value">{{ run_mode }}</div>
        </div>
        <div class="stat-card">
          <div class="stat-label">Generated</div>
          <div class="stat-value">{{ generated_at }}</div>
        </div>
        <div class="stat-card">
          <div class="stat-label">Samples</div>
          <div class="stat-value">{{ samples | length }}</div>
        </div>
      </div>
    </div>
  </header>

  <section class="overview-grid">
    <div class="panel">
      <h2 class="panel-title h5">Run configuration</h2>
      <div class="tag-list mb-3">
        <span class="tag">{{ "Preprocessing enabled" if preprocessing_enabled else "Preprocessing skipped" }}</span>
        <span class="tag">{{ "Host removal enabled" if host_removal_enabled else "Host removal disabled" }}</span>
        {% if host_ref %}
        <span class="tag">Host reference configured</span>
        {% endif %}
      </div>
      <div class="meta-grid">
        <div class="meta-item">
          <strong>Filtering method</strong>
          <span>{{ filtering_method if preprocessing_enabled else "Not applied" }}</span>
        </div>
        <div class="meta-item">
          <strong>Quality thresholds</strong>
          <span>
            {% if filtering_method == "chopper" %}
              Min length {{ chopper_min_length }} bp &middot; Q{{ chopper_quality }}
            {% else %}
              Min length {{ filtlong_min_length }} bp &middot; keep {{ filtlong_keep_percent }}%
            {% endif %}
          </span>
        </div>
        {% if host_ref %}
        <div class="meta-item">
          <strong>Host reference</strong>
          <span><code>{{ host_ref }}</code></span>
        </div>
        {% endif %}
      </div>
      {% if versions %}
      <h3 class="panel-title h6 mt-4">Tool versions</h3>
      <div class="table-responsive">
        <table class="table table-sm align-middle">
          <thead><tr><th>Tool</th><th>Version</th></tr></thead>
          <tbody>
          {% for tool, ver in versions.items() %}
            <tr><td><code>{{ tool }}</code></td><td>{{ ver }}</td></tr>
          {% endfor %}
          </tbody>
        </table>
      </div>
      {% endif %}
    </div>

    <div class="panel workflow-card">
      <h2 class="panel-title h5">
        Pipeline overview
        <span class="help-icon">?<span class="help-tooltip">Interactive workflow diagram: hover (or tab to and focus) a tool dot to see what it does in the pipeline. Colours group tools by pipeline stage, matching the legend below.</span></span>
      </h2>
      {% if workflow_diagram and workflow_diagram.nodes %}
        <div class="tag-list workflow-legend">
          {% for cat in workflow_diagram.legend %}
          <span class="tag"><span class="legend-swatch" style="background: {{ cat.color }};"></span>{{ cat.label }}</span>
          {% endfor %}
        </div>
        <div class="workflow-svg-wrap">
          <svg class="workflow-svg" viewBox="0 0 1000 520" role="img"
               aria-label="Interactive gaia pipeline workflow diagram. Hover or focus each tool node for details.">
            {% for edge in workflow_diagram.edges %}
            <line class="wf-edge" x1="{{ edge.x1 * 12 }}" y1="{{ edge.y1 * 5 }}"
                  x2="{{ edge.x2 * 12 }}" y2="{{ edge.y2 * 5 }}" stroke="{{ edge.color }}"/>
            {% endfor %}
            {% for node in workflow_diagram.nodes %}
            <g class="wf-node" tabindex="0" transform="translate({{ node.x * 12 }}, {{ node.y * 5 }})">
              <title>{{ node.label }}: {{ node.description }}</title>
              <circle class="wf-hit" r="20"/>
              <circle class="wf-dot" r="9" stroke="{{ node.color }}"/>
              <text class="wf-label" y="-16">{{ node.label }}</text>
              <foreignObject x="-115" y="-96" width="230" height="76" overflow="visible">
                <div xmlns="http://www.w3.org/1999/xhtml" class="wf-tooltip">
                  <strong>{{ node.label }}</strong>{{ node.description }}
                </div>
              </foreignObject>
            </g>
            {% endfor %}
          </svg>
        </div>
      {% elif workflow_image %}
        <img src="{{ workflow_image }}" alt="Pipeline workflow"/>
      {% else %}
        <div class="empty-state">No workflow overview information was available for embedding.</div>
      {% endif %}
    </div>
  </section>

  {% if assembly_overview.enabled %}
  <section class="section-card" style="margin-top: 22px;">
    <div class="section-kicker">Genome reconstruction</div>
    <h2 class="panel-title h5">
      Assembly overview
      <span class="help-icon">?<span class="help-tooltip">Run-level summary of MetaFlye assembly quality across all samples, collapsed into a single overview instead of per-sample sections to keep the report concise. N50 and related metrics come from MetaQUAST when available, or are otherwise computed directly from the assembly contigs.</span></span>
    </h2>
    {% if assembly_overview.rows %}
    <div class="metrics-grid mb-3">
      <div class="metric">
        <div class="stat-label">Samples assembled</div>
        <div class="stat-value">{{ assembly_overview.samples_assembled }} / {{ assembly_overview.samples_total }}</div>
      </div>
      <div class="metric">
        <div class="stat-label">Total contigs</div>
        <div class="stat-value">{{ assembly_overview.total_contigs }}</div>
      </div>
      <div class="metric">
        <div class="stat-label">Total assembly length (bp)</div>
        <div class="stat-value">{{ "{:,}".format(assembly_overview.total_length) }}</div>
      </div>
      <div class="metric">
        <div class="stat-label">Median N50 (bp)</div>
        <div class="stat-value">
          {% if assembly_overview.median_n50 is not none %}{{ "{:,}".format(assembly_overview.median_n50) }}{% else %}—{% endif %}
        </div>
      </div>
      <div class="metric">
        <div class="stat-label">N50 range (bp)</div>
        <div class="stat-value">
          {% if assembly_overview.min_n50 is not none %}{{ "{:,}".format(assembly_overview.min_n50) }} – {{ "{:,}".format(assembly_overview.max_n50) }}{% else %}—{% endif %}
        </div>
      </div>
    </div>
    <div class="table-responsive">
      <table class="table table-sm align-middle">
        <thead><tr><th>Sample</th><th>Contigs</th><th>Total length (bp)</th><th>N50 (bp)</th><th>Largest contig (bp)</th></tr></thead>
        <tbody>
        {% for row in assembly_overview.rows %}
          <tr>
            <td>{{ row.sample }}</td>
            <td>{{ row.contig_count }}</td>
            <td>{{ row.total_length }}</td>
            <td>{{ row.n50 }}</td>
            <td>{{ row.largest_contig }}</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
    {% else %}
    <div class="empty-state">No assembly statistics were available for this run.</div>
    {% endif %}
  </section>
  {% endif %}

  {% if binning_overview.applicable %}
  <section class="section-card" style="margin-top: 22px;">
    <div class="section-kicker">Genome reconstruction</div>
    <h2 class="panel-title h5">
      Binning overview
      <span class="help-icon">?<span class="help-tooltip">Run-level summary of genome bins recovered per sample, collapsed across all samples instead of shown per sample. Samples for which binning was not performed (disabled, or skipped because the assembly did not pass the post-assembly binning gate) are listed explicitly below.</span></span>
    </h2>
    <div class="metrics-grid mb-3">
      <div class="metric">
        <div class="stat-label">Samples binned</div>
        <div class="stat-value">{{ binning_overview.samples_binned }} / {{ binning_overview.samples_total }}</div>
      </div>
      <div class="metric">
        <div class="stat-label">Total final genomes</div>
        <div class="stat-value">{{ binning_overview.total_final_genomes }}</div>
      </div>
      <div class="metric">
        <div class="stat-label">Prokaryotic bins (high / medium quality)</div>
        <div class="stat-value">{{ binning_overview.high_quality_prok }} / {{ binning_overview.medium_quality_prok }}</div>
      </div>
      <div class="metric">
        <div class="stat-label">Eukaryotic bins with taxonomy</div>
        <div class="stat-value">{{ binning_overview.euk_bins_with_taxonomy }}</div>
      </div>
    </div>
    {% if binning_overview.not_binned_samples %}
    <div class="alert alert-warning" role="alert">
      Binning was not performed for {{ binning_overview.not_binned_samples | length }} sample(s):
      {{ binning_overview.not_binned_samples | join(", ") }}.
      This happens when binning is disabled for the run, or when a sample's assembly did not pass
      the post-assembly binning gate (too few/short contigs).
    </div>
    {% endif %}
    <div class="table-responsive">
      <table class="table table-sm align-middle">
        <thead>
          <tr>
            <th>Sample</th><th>Binned</th><th>Final genomes</th>
            <th>Prok bins</th><th>Euk bins</th>
            <th>High-quality prok</th><th>Medium-quality prok</th>
            <th>Euk bins w/ taxonomy</th>
          </tr>
        </thead>
        <tbody>
        {% for row in binning_overview.rows %}
          <tr>
            <td>{{ row.sample }}</td>
            <td>{{ "Yes" if row.binned else "Not binned" }}</td>
            <td>{{ row.total_final_genomes }}</td>
            <td>{{ row.total_bins_prok }}</td>
            <td>{{ row.total_bins_euk }}</td>
            <td>{{ row.high_quality_prok }}</td>
            <td>{{ row.medium_quality_prok }}</td>
            <td>{{ row.euk_bins_with_taxonomy }}</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
  </section>
  {% endif %}

  <section class="sample-nav">
    <div class="sample-tabs">
      {% for sd in samples_data %}
      <a class="sample-tab" href="#sample-{{ loop.index }}">Sample {{ sd.sample }}</a>
      {% endfor %}
    </div>
  </section>

  {% for sd in samples_data %}
  <article class="sample-report" id="sample-{{ loop.index }}">
    <div class="sample-header">
      <div class="sample-banner">
        <h2>Sample <code>{{ sd.sample }}</code></h2>
        <p class="mb-0">
          {% set taxonomy_tools = [] %}
          {% if sd.kraken2_species %}{% set _ = taxonomy_tools.append("Kraken2") %}{% endif %}
          {% if sd.centrifuger_species %}{% set _ = taxonomy_tools.append("Centrifuger") %}{% endif %}
          {% if taxonomy_tools %}
            Taxonomy available from {{ taxonomy_tools | join(" and ") }}.
          {% else %}
            No taxonomy summaries were generated for this sample.
          {% endif %}
        </p>
      </div>
      <div class="metrics-grid">
        <div class="metric">
          <div class="stat-label">Host removal</div>
          <div class="stat-value">
            {% if sd.host_stats %}
              {{ sd.host_stats.non_host_percentage }}% retained
            {% else %}
              Not reported
            {% endif %}
          </div>
        </div>
        <div class="metric">
          <div class="stat-label">Taxonomy tables</div>
          <div class="stat-value">
            {{ (1 if sd.kraken2_species else 0) + (1 if sd.centrifuger_species else 0) }}
          </div>
        </div>
        <div class="metric">
          <div class="stat-label">Kraken2 top species</div>
          <div class="stat-value">{{ sd.kraken2_species | length }}</div>
        </div>
        <div class="metric">
          <div class="stat-label">Centrifuger top species</div>
          <div class="stat-value">{{ sd.centrifuger_species | length }}</div>
        </div>
      </div>
    </div>

    <div class="content-grid">
      {% if sd.host_stats and sd.host_plot_data %}
      <section class="section-card split">
        <div class="section-kicker">Host removal</div>
        <h3 class="section-title h5">
          Read partitioning
          <span class="help-icon">?<span class="help-tooltip">Proportion of sequencing reads mapped to the host genome versus non-host (microbial) reads. Non-host reads proceed to downstream taxonomic and genomic analyses.</span></span>
        </h3>
        <div id="host-removal-plot-{{ sd.sample }}" class="plot"></div>
      </section>

      <section class="section-card split">
        <div class="section-kicker">Host removal</div>
        <h3 class="section-title h5">Counts and percentages</h3>
        <div class="table-responsive">
          <table class="table table-sm align-middle">
            <thead><tr><th>Read category</th><th>Count</th><th>Percentage</th></tr></thead>
            <tbody>
              <tr><td>Host</td><td>{{ sd.host_stats.host_reads | int }}</td><td>{{ sd.host_stats.host_percentage }}%</td></tr>
              <tr><td>Non-host</td><td>{{ sd.host_stats.non_host_reads | int }}</td><td>{{ sd.host_stats.non_host_percentage }}%</td></tr>
              <tr class="fw-semibold"><td>Total</td><td>{{ sd.host_stats.total_reads | int }}</td><td>100%</td></tr>
            </tbody>
          </table>
        </div>
      </section>
      {% endif %}

      {% if sd.nanoplot_raw or sd.nanoplot_filtered %}
      <section class="section-card">
        <div class="section-kicker">Read quality</div>
        <h3 class="section-title h5">
          NanoPlot metrics – raw vs filtered
          <span class="help-icon">?<span class="help-tooltip">Summary of read-level quality and length statistics produced by NanoPlot, comparing raw (pre-filtering) and filtered reads. Higher values for quality and length indicate better sequencing output.</span></span>
        </h3>
        <div class="table-responsive mb-3">
          <table class="table table-sm align-middle">
            <thead><tr><th>Metric</th><th>Raw</th><th>Filtered</th></tr></thead>
            <tbody>
            {% set metric_labels = [
              ("number_of_reads",    "Number of reads"),
              ("total_bases",        "Total bases"),
              ("mean_read_length",   "Mean read length (bp)"),
              ("median_read_length", "Median read length (bp)"),
              ("read_length_n50",    "Read length N50 (bp)"),
              ("mean_read_quality",  "Mean read quality"),
              ("median_read_quality","Median read quality"),
              ("active_channels",    "Active channels"),
            ] %}
            {% for key, label in metric_labels %}
              {% if sd.nanoplot_raw.get(key) is not none or sd.nanoplot_filtered.get(key) is not none %}
              <tr>
                <td>{{ label }}</td>
                <td>{{ sd.nanoplot_raw.get(key, "—") }}</td>
                <td>{{ sd.nanoplot_filtered.get(key, "—") }}</td>
              </tr>
              {% endif %}
            {% endfor %}
            </tbody>
          </table>
        </div>
        <div id="nanoplot-chart-{{ sd.sample }}" class="plot" style="min-height:350px;"></div>
        <div id="nanoplot-quality-chart-{{ sd.sample }}" class="plot" style="min-height:280px; margin-top:14px;"></div>
      </section>
      {% endif %}

      {% if sd.kraken2_species %}
      <section class="section-card split">
        <div class="section-kicker">Taxonomy</div>
        <h3 class="section-title h5">
          Kraken2 top species
          <span class="help-icon">?<span class="help-tooltip">Taxonomic classification results from Kraken2. The table shows the most abundant species identified in the sample, ranked by read count.</span></span>
        </h3>
        <div class="table-responsive">
          <table class="table table-sm align-middle">
            <thead><tr><th>Species</th><th>Reads</th><th>Percentage (%)</th></tr></thead>
            <tbody>
            {% for row in sd.kraken2_species %}
              <tr><td>{{ row.name }}</td><td>{{ row.reads }}</td><td>{{ row.percent }}</td></tr>
            {% endfor %}
            </tbody>
          </table>
        </div>
      </section>

      <section class="section-card split">
        <div class="section-kicker">Taxonomy</div>
        <h3 class="section-title h5">Kraken2 abundance chart (Top 10)</h3>
        <div id="kraken2-plot-{{ sd.sample }}" class="plot" style="min-height:420px;"></div>
      </section>
      {% endif %}

      {% if sd.centrifuger_species %}
      <section class="section-card split">
        <div class="section-kicker">Taxonomy</div>
        <h3 class="section-title h5">
          Centrifuger top species
          <span class="help-icon">?<span class="help-tooltip">Taxonomic classification results from Centrifuger. The table shows the most abundant species identified in the sample, ranked by read count. The percentage column is Centrifuger's abundance estimate: the proportion of this genome normalized by its genomic length, not a raw share of classified reads.</span></span>
        </h3>
        <div class="table-responsive">
          <table class="table table-sm align-middle">
            <thead><tr><th>Species</th><th>Reads</th><th>Genome-normalized abundance (%)</th></tr></thead>
            <tbody>
            {% for row in sd.centrifuger_species %}
              <tr><td>{{ row.name }}</td><td>{{ row.reads }}</td><td>{{ row.percent }}</td></tr>
            {% endfor %}
            </tbody>
          </table>
        </div>
      </section>

      <section class="section-card split">
        <div class="section-kicker">Taxonomy</div>
        <h3 class="section-title h5">Centrifuger abundance chart (Top 10)</h3>
        <div id="centrifuger-plot-{{ sd.sample }}" class="plot" style="min-height:420px;"></div>
      </section>
      {% endif %}
    </div>
  </article>
  {% endfor %}
    </main>
  </div>
</div>

<script>
  var plotTheme = {
    paper_bgcolor: 'rgba(0,0,0,0)',
    plot_bgcolor: '#ffffff',
    font: {family: '"Segoe UI", Arial, sans-serif', color: '#1d2840'},
    margin: {l: 70, r: 20, t: 10, b: 45}
  };

  function renderHorizontalBar(containerId, rows, barColor, chartTitle) {
    if (!rows || rows.length === 0) return;
    var el = document.getElementById(containerId);
    if (!el) return;
    var topRows = rows
      .slice()
      .sort(function(a, b) { return Number(b.percent || 0) - Number(a.percent || 0); })
      .slice(0, 10);
    Plotly.newPlot(containerId, [{
      type: 'bar',
      orientation: 'h',
      x: topRows.map(function(r) { return Number(r.reads || 0); }),
      y: topRows.map(function(r) {
        var pct = Number(r.percent || 0);
        return r.name + ' (' + pct.toFixed(1) + '%)';
      }),
      customdata: topRows.map(function(r) { return Number(r.percent || 0); }),
      marker: {color: barColor, line: {color: barColor, width: 1}},
      hovertemplate: '%{y}<br>Reads: %{x:,}<br>Percentage: %{customdata:.1f}%<extra></extra>'
    }], Object.assign({}, plotTheme, {
      title: {text: chartTitle + ' (Top 10)', font: {size: 14, color: '#1d2840'}},
      margin: {l: 230, r: 20, t: 10, b: 45},
      xaxis: {
        title: 'Reads',
        gridcolor: '#d9e3f0',
        zerolinecolor: '#d9e3f0'
      },
      yaxis: {automargin: true, autorange: 'reversed'}
    }), {responsive: true, displayModeBar: false});
  }

  {% for sd in samples_data %}
  (function() {
    var sampleId = {{ sd.sample | tojson }};
    var kraken2Species = {{ sd.kraken2_species | tojson }};
    var centrifugerSpecies = {{ sd.centrifuger_species | tojson }};
    var hostPlotData = {% if sd.host_plot_data %}{{ sd.host_plot_data | tojson }}{% else %}null{% endif %};

    if (hostPlotData) {
      Plotly.newPlot('host-removal-plot-' + sampleId, [{
        type: 'pie',
        labels: hostPlotData.labels,
        values: hostPlotData.values,
        hole: 0.62,
        marker: {colors: ['#10164f', '#19b6d4']},
        textinfo: 'label+percent',
        hovertemplate: '%{label}: %{value:,} (%{percent})<extra></extra>'
      }], Object.assign({}, plotTheme, {
        margin: {l: 20, r: 20, t: 10, b: 10},
        showlegend: true,
        legend: {orientation: 'h', y: -0.1}
      }), {responsive: true, displayModeBar: false});
    }

    renderHorizontalBar('kraken2-plot-' + sampleId, kraken2Species, '#19b6d4', 'Kraken2 abundance');
    renderHorizontalBar('centrifuger-plot-' + sampleId, centrifugerSpecies, '#10164f', 'Centrifuger abundance');

    (function() {
      var rawMetrics = {{ sd.nanoplot_raw | tojson }};
      var filteredMetrics = {{ sd.nanoplot_filtered | tojson }};
      var chartEl = document.getElementById('nanoplot-chart-' + sampleId);
      if (!chartEl || (!Object.keys(rawMetrics).length && !Object.keys(filteredMetrics).length)) return;

      // Length/yield metrics (primary chart – values in bp / counts)
      var lengthKeys = [
        ['mean_read_length',   'Mean read length (bp)'],
        ['median_read_length', 'Median read length (bp)'],
        ['read_length_n50',    'N50 (bp)']
      ];
      var lengthLabels = [], lengthRaw = [], lengthFilt = [];
      lengthKeys.forEach(function(kl) {
        var key = kl[0], label = kl[1];
        if (rawMetrics[key] !== undefined || filteredMetrics[key] !== undefined) {
          lengthLabels.push(label);
          lengthRaw.push(rawMetrics[key] !== undefined ? rawMetrics[key] : null);
          lengthFilt.push(filteredMetrics[key] !== undefined ? filteredMetrics[key] : null);
        }
      });
      if (lengthLabels.length) {
        Plotly.newPlot('nanoplot-chart-' + sampleId, [
          {
            name: 'Raw',
            type: 'bar',
            x: lengthLabels,
            y: lengthRaw,
            marker: {color: '#19b6d4'},
            hovertemplate: '%{x}: %{y:,}<extra>Raw</extra>'
          },
          {
            name: 'Filtered',
            type: 'bar',
            x: lengthLabels,
            y: lengthFilt,
            marker: {color: '#10164f'},
            hovertemplate: '%{x}: %{y:,}<extra>Filtered</extra>'
          }
        ], Object.assign({}, plotTheme, {
          barmode: 'group',
          title: {text: 'NanoPlot: Read length metrics – raw vs filtered', font: {size: 14, color: '#1d2840'}},
          margin: {l: 70, r: 20, t: 40, b: 80},
          xaxis: {tickangle: -20, automargin: true},
          yaxis: {title: 'Length (bp)', gridcolor: '#d9e3f0', zerolinecolor: '#d9e3f0'},
          legend: {orientation: 'h', y: -0.25},
          showlegend: true
        }), {responsive: true, displayModeBar: false});
      }

      // Quality metrics (separate chart – Phred Q-score scale, ~0–40)
      var qualKeys = [
        ['mean_read_quality',   'Mean quality (Q)'],
        ['median_read_quality', 'Median quality (Q)']
      ];
      var qualLabels = [], qualRaw = [], qualFilt = [];
      qualKeys.forEach(function(kl) {
        var key = kl[0], label = kl[1];
        if (rawMetrics[key] !== undefined || filteredMetrics[key] !== undefined) {
          qualLabels.push(label);
          qualRaw.push(rawMetrics[key] !== undefined ? rawMetrics[key] : null);
          qualFilt.push(filteredMetrics[key] !== undefined ? filteredMetrics[key] : null);
        }
      });
      var qualEl = document.getElementById('nanoplot-quality-chart-' + sampleId);
      if (qualEl && qualLabels.length) {
        Plotly.newPlot('nanoplot-quality-chart-' + sampleId, [
          {
            name: 'Raw',
            type: 'bar',
            x: qualLabels,
            y: qualRaw,
            marker: {color: '#19b6d4'},
            hovertemplate: '%{x}: %{y:.2f}<extra>Raw</extra>'
          },
          {
            name: 'Filtered',
            type: 'bar',
            x: qualLabels,
            y: qualFilt,
            marker: {color: '#10164f'},
            hovertemplate: '%{x}: %{y:.2f}<extra>Filtered</extra>'
          }
        ], Object.assign({}, plotTheme, {
          barmode: 'group',
          title: {text: 'NanoPlot: Read quality (Phred Q-score) – raw vs filtered', font: {size: 14, color: '#1d2840'}},
          margin: {l: 70, r: 20, t: 40, b: 80},
          xaxis: {automargin: true},
          yaxis: {title: 'Phred quality score (Q)', gridcolor: '#d9e3f0', zerolinecolor: '#d9e3f0', rangemode: 'tozero'},
          legend: {orientation: 'h', y: -0.25},
          showlegend: true
        }), {responsive: true, displayModeBar: false});
      }
    })();
  })();
  {% endfor %}
</script>
</body>
</html>
