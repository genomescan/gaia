<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>Gaia run report</title>
  <link rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
        crossorigin="anonymous"/>
  {{ plotly_js }}
  <style>
    :root {
      --nv-navy: #10164f;
      --nv-navy-soft: #1a236f;
      --nv-cyan: #19b6d4;
      --nv-cyan-soft: #dff6fb;
      --nv-bg: #f4f7fb;
      --nv-card: #ffffff;
      --nv-text: #1d2840;
      --nv-muted: #67748b;
      --nv-border: #d9e3f0;
      --nv-shadow: 0 18px 45px rgba(16, 22, 79, 0.10);
      --nv-radius: 22px;
    }

    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: linear-gradient(180deg, #eef4fb 0%, var(--nv-bg) 180px);
      color: var(--nv-text);
      font-family: "Segoe UI", Arial, sans-serif;
    }

    .page {
      max-width: 1560px;
      margin: 0 auto;
      padding: 24px;
    }

    .layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 18px;
      align-items: start;
    }

    .hero {
      background: linear-gradient(135deg, var(--nv-navy) 0%, var(--nv-navy-soft) 55%, #26339c 100%);
      color: #fff;
      border-radius: 28px;
      padding: 28px 30px;
      box-shadow: var(--nv-shadow);
      overflow: hidden;
      position: relative;
    }

    .hero::after {
      content: "";
      position: absolute;
      inset: 0;
      background:
        radial-gradient(circle at top right, rgba(255,255,255,0.20), transparent 30%),
        radial-gradient(circle at bottom left, rgba(25,182,212,0.22), transparent 30%);
      pointer-events: none;
    }

    .hero-top,
    .hero-stats,
    .overview-grid,
    .metrics-grid,
    .content-grid {
      display: grid;
      gap: 16px;
    }

    .hero-top {
      grid-template-columns: minmax(0, 1.8fr) minmax(280px, 1fr);
      align-items: end;
      position: relative;
      z-index: 1;
    }

    .brand-chip,
    .tag {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      border-radius: 999px;
      font-weight: 600;
    }

    .brand-chip {
      background: rgba(255,255,255,0.12);
      border: 1px solid rgba(255,255,255,0.18);
      color: #fff;
      padding: 10px 14px;
      margin-bottom: 16px;
      letter-spacing: 0.02em;
    }

    .hero h1 {
      margin: 0 0 10px;
      font-size: clamp(2rem, 3vw, 3rem);
      font-weight: 700;
    }

    .hero p,
    .hero code {
      color: rgba(255,255,255,0.92);
    }

    .hero-summary {
      max-width: 720px;
      line-height: 1.5;
      margin-bottom: 0;
    }

    .hero-stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      position: relative;
      z-index: 1;
    }

    .stat-card,
    .panel,
    .metric,
    .section-card {
      background: var(--nv-card);
      border-radius: var(--nv-radius);
      box-shadow: var(--nv-shadow);
    }

    .stat-card {
      background: rgba(255,255,255,0.12);
      border: 1px solid rgba(255,255,255,0.18);
      padding: 16px 18px;
      min-height: 98px;
    }

    .stat-label {
      font-size: 0.75rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.78);
      margin-bottom: 6px;
    }

    .stat-value {
      font-size: 1.3rem;
      font-weight: 700;
      word-break: break-word;
    }

    .overview-grid {
      grid-template-columns: minmax(260px, 360px) minmax(0, 1fr);
      margin-top: 22px;
      align-items: start;
    }

    .panel {
      padding: 22px;
      border: 1px solid var(--nv-border);
    }

    .panel-title,
    .section-title {
      margin: 0 0 12px;
      color: var(--nv-navy);
      font-weight: 700;
    }

    .panel-subtitle,
    .muted {
      color: var(--nv-muted);
    }

    .tag-list {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .tag {
      background: var(--nv-cyan-soft);
      color: var(--nv-navy);
      border: 1px solid rgba(25,182,212,0.20);
      padding: 8px 12px;
      text-decoration: none;
    }

    .workflow-card img {
      width: 100%;
      border-radius: 18px;
      border: 1px solid var(--nv-border);
      background: #fff;
    }

	.workflow-image-wrap {
	  position: relative;
	  width: 100%;
	  border-radius: 18px;
	  border: 1px solid var(--nv-border);
	  background: #fff;
	  overflow: hidden;
	}

	.workflow-base {
	  display: block;
	  width: 100%;
	  height: auto;
	  border: 0;          /* override generic .workflow-card img border */
	  border-radius: 0;   /* keep wrapper as the rounded border */
	}

	.workflow-hotspots {
	  position: absolute;
	  inset: 0;
	  width: 100%;
	  height: 100%;
	  pointer-events: none; /* let only hotspots receive events */
	}

	.workflow-hotspots .hs {
	  pointer-events: auto;
	  cursor: pointer;
	}

	.workflow-hotspots .hs circle {
	  fill: rgba(25, 182, 212, 0.18);
	  stroke: #10164f;
	  stroke-width: 2;
	}

	.workflow-hotspots .hs:hover circle,
	.workflow-hotspots .hs:focus circle,
	.workflow-hotspots .hs:focus-visible circle {
	  fill: rgba(25, 182, 212, 0.32);
	  stroke: #19b6d4;
	  stroke-width: 3;
	}

	.workflow-hotspots .hs:focus {
	  outline: none;
	}

    /* Interactive workflow diagram (inline SVG, see report.html.j2 +
       render_report.py WORKFLOW_NODES/WORKFLOW_EDGES for the underlying
       data). Hover/focus a tool node to reveal its tooltip. */
    .workflow-legend {
      margin-bottom: 14px;
    }

    .workflow-legend .tag {
      display: inline-flex;
      align-items: center;
      gap: 7px;
    }

    .workflow-legend .legend-swatch {
      width: 11px;
      height: 11px;
      border-radius: 50%;
      flex: 0 0 auto;
      display: inline-block;
    }

    .workflow-svg-wrap {
      width: 100%;
      border-radius: 18px;
      border: 1px solid var(--nv-border);
      background: #fff;
      padding: 6px;
    }

    .workflow-svg {
      width: 100%;
      height: auto;
      display: block;
    }

    .wf-edge {
      fill: none;
      stroke-width: 3;
      stroke-linecap: round;
      opacity: 0.55;
    }

    .wf-node {
      cursor: pointer;
    }

    .wf-node circle.wf-hit {
      fill: transparent;
    }

    .wf-node circle.wf-dot {
      stroke-width: 3;
      fill: #fff;
      transition: filter 0.15s ease, stroke-width 0.15s ease;
    }

    .wf-node:hover circle.wf-dot,
    .wf-node:focus circle.wf-dot,
    .wf-node:focus-visible circle.wf-dot {
      stroke-width: 4;
      filter: drop-shadow(0 2px 6px rgba(16, 22, 79, 0.35));
    }

    .wf-node:focus {
      outline: none;
    }

    .wf-label {
      font-size: 12px;
      fill: var(--nv-text);
      text-anchor: middle;
      pointer-events: none;
    }

    .wf-tooltip {
      display: none;
      background: var(--nv-navy);
      color: #fff;
      font-size: 0.78rem;
      font-weight: 400;
      line-height: 1.45;
      padding: 8px 12px;
      border-radius: 10px;
      box-shadow: 0 4px 18px rgba(16, 22, 79, 0.22);
      pointer-events: none;
    }

    .wf-tooltip strong {
      display: block;
      margin-bottom: 3px;
      color: #fff;
    }

    .wf-node:hover .wf-tooltip,
    .wf-node:focus .wf-tooltip,
    .wf-node:focus-visible .wf-tooltip {
      display: block;
    }

    .metrics-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .metric {
      padding: 16px 18px;
      border: 1px solid var(--nv-border);
    }

    .metric .stat-label {
      color: var(--nv-muted);
    }

    .metric .stat-value {
      color: var(--nv-navy);
      font-size: 1rem;
    }

    .content-grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      margin-top: 18px;
    }

    .section-card {
      padding: 22px;
      border: 1px solid var(--nv-border);
      grid-column: span 12;
    }

    .section-card.split {
      grid-column: span 6;
    }

    .section-kicker {
      display: inline-block;
      margin-bottom: 8px;
      font-size: 0.75rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--nv-cyan);
      font-weight: 700;
    }

    .meta-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 14px;
    }

    .meta-item {
      padding: 14px;
      border-radius: 16px;
      background: #f8fbff;
      border: 1px solid var(--nv-border);
    }

    .meta-item strong {
      display: block;
      color: var(--nv-muted);
      font-size: 0.85rem;
      margin-bottom: 4px;
      font-weight: 600;
    }

    .plot {
      width: 100%;
      min-height: 320px;
    }

    .table {
      margin-bottom: 0;
      --bs-table-bg: transparent;
    }

    .table thead th {
      color: var(--nv-navy);
      background: #f6fbff;
      border-bottom-width: 1px;
      font-size: 0.85rem;
    }

    .table td,
    .table th {
      vertical-align: middle;
      border-color: var(--nv-border);
    }

    .empty-state {
      padding: 18px;
      border-radius: 18px;
      background: #f8fbff;
      color: var(--nv-muted);
      border: 1px dashed var(--nv-border);
    }

    /* Tooltip help icon */
    .help-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background: var(--nv-cyan-soft);
      border: 1px solid rgba(25,182,212,0.35);
      color: var(--nv-navy);
      font-size: 0.68rem;
      font-weight: 700;
      cursor: default;
      position: relative;
      top: -1px;
      margin-left: 7px;
      vertical-align: middle;
      user-select: none;
    }

    .help-icon .help-tooltip {
      display: none;
      position: absolute;
      left: 50%;
      bottom: calc(100% + 6px);
      transform: translateX(-50%);
      background: var(--nv-navy);
      color: #fff;
      font-size: 0.78rem;
      font-weight: 400;
      line-height: 1.45;
      padding: 8px 12px;
      border-radius: 10px;
      white-space: normal;
      width: 240px;
      z-index: 999;
      box-shadow: 0 4px 18px rgba(16,22,79,0.22);
      pointer-events: none;
    }

    .help-icon:hover .help-tooltip {
      display: block;
    }

    @media (max-width: 1080px) {
      .layout {
        grid-template-columns: 1fr;
      }
      .hero-top,
      .overview-grid {
        grid-template-columns: 1fr;
      }

      .section-card.split {
        grid-column: span 12;
      }
    }

    @media (max-width: 768px) {
      .page {
        padding: 14px;
      }

      .hero,
      .panel,
      .section-card {
        padding: 18px;
      }

      .hero-stats,
      .metrics-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>
<div class="page">
  <div class="layout">
    <main>
  <header class="hero">
    <div class="hero-top">
      <div>
        <div class="brand-chip">Gaia &middot; analysis pipeline for long-read shotgun metagenomics</div>
        <h1>Metagenomics run report</h1>
        <p class="hero-summary">
          A consolidated overview of preprocessing, host removal, taxonomic profiling, and genome
          reconstruction (assembly and binning, summarized across all samples) for
          <code>{{ samples | length }}</code> sample(s).
        </p>
      </div>
      <div class="hero-stats">
        <div class="stat-card">
          <div class="stat-label">Run mode</div>
          <div class="stat-value">{{ run_mode }}</div>
        </div>
        <div class="stat-card">
          <div class="stat-label">Generated</div>
          <div class="stat-value">{{ generated_at }}</div>
        </div>
        <div class="stat-card">
          <div class="stat-label">Samples</div>
          <div class="stat-value">{{ samples | length }}</div>
        </div>
      </div>
    </div>
  </header>

  <section class="overview-grid">
    <div class="panel">
      <h2 class="panel-title h5">Run configuration</h2>
      <div class="tag-list mb-3">
        <span class="tag">{{ "Preprocessing enabled" if preprocessing_enabled else "Preprocessing skipped" }}</span>
        <span class="tag">{{ "Host removal enabled" if host_removal_enabled else "Host removal disabled" }}</span>
        {% if host_ref %}
        <span class="tag">Host reference configured</span>
        {% endif %}
      </div>
      <div class="meta-grid">
        <div class="meta-item">
          <strong>Filtering method</strong>
          <span>{{ filtering_method if preprocessing_enabled else "Not applied" }}</span>
        </div>
        <div class="meta-item">
          <strong>Quality thresholds</strong>
          <span>
            {% if filtering_method == "chopper" %}
              Min length {{ chopper_min_length }} bp &middot; Q{{ chopper_quality }}
            {% else %}
              Min length {{ filtlong_min_length }} bp &middot; keep {{ filtlong_keep_percent }}%
            {% endif %}
          </span>
        </div>
        {% if host_ref %}
        <div class="meta-item">
          <strong>Host reference</strong>
          <span><code>{{ host_ref }}</code></span>
        </div>
        {% endif %}
      </div>
      {% if versions %}
      <h3 class="panel-title h6 mt-4">Tool versions</h3>
      <div class="table-responsive">
        <table class="table table-sm align-middle">
          <thead><tr><th>Tool</th><th>Version</th></tr></thead>
          <tbody>
          {% for tool, ver in versions.items() %}
            <tr><td><code>{{ tool }}</code></td><td>{{ ver }}</td></tr>
          {% endfor %}
          </tbody>
        </table>
      </div>
      {% endif %}
    </div>

    <div class="panel workflow-card">
      <h2 class="panel-title h5">
        Pipeline overview
        <span class="help-icon">?<span class="help-tooltip">Interactive workflow diagram: hover (or tab to and focus) a tool dot to see what it does in the pipeline. Colours group tools by pipeline stage, matching the legend below.</span></span>
      </h2>
			{% if workflow_image %}
				<div class="workflow-image-wrap">
					<img src="{{ workflow_image }}" alt="Pipeline workflow" class="workflow-base"/>

					<svg class="workflow-hotspots" viewBox="0 0 821 821" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Workflow with interactive node hotspots">
						<g class="hs" tabindex="0"><title>Generate quality-control metrics for raw sequencing reads.</title><circle cx="194" cy="260" r="14"/></g>
						<g class="hs" tabindex="0"><title>Align reads to the host reference and process alignment files.</title><circle cx="305" cy="260" r="14"/></g>
						<g class="hs" tabindex="0"><title>Trim/filter reads by quality score and minimum length.</title><circle cx="415" cy="260" r="14"/></g>
						<g class="hs" tabindex="0"><title>Filter reads to retain the highest-quality subset for downstream analysis.</title><circle cx="525" cy="260" r="14"/></g>
						<g class="hs" tabindex="0"><title>Generate quality-control metrics for filtered reads.</title><circle cx="635" cy="260" r="14"/></g>

						<g class="hs" tabindex="0"><title>Estimate read coverage/depth to support assembly and binning.</title><circle cx="415" cy="350" r="14"/></g>
						<g class="hs" tabindex="0"><title>Assemble long reads into contigs.</title><circle cx="525" cy="388" r="14"/></g>
						<g class="hs" tabindex="0"><title>Assess assembly quality statistics.</title><circle cx="470" cy="465" r="14"/></g>

						<g class="hs" tabindex="0"><title>Recover metagenome bins using graph-based binning.</title><circle cx="305" cy="360" r="14"/></g>
						<g class="hs" tabindex="0"><title>Recover metagenome bins using tetranucleotide composition and abundance.</title><circle cx="305" cy="390" r="14"/></g>
						<g class="hs" tabindex="0"><title>Recover metagenome bins using coverage/composition clustering.</title><circle cx="305" cy="420" r="14"/></g>

						<g class="hs" tabindex="0"><title>Refine eukaryotic bins for completeness and quality.</title><circle cx="100" cy="540" r="14"/></g>
						<g class="hs" tabindex="0"><title>Dereplicate and quality-check eukaryotic bins.</title><circle cx="100" cy="615" r="14"/></g>
						<g class="hs" tabindex="0"><title>Assign taxonomy to eukaryotic bins.</title><circle cx="100" cy="695" r="14"/></g>

						<g class="hs" tabindex="0"><title>Merge and refine prokaryotic bins from multiple binning methods.</title><circle cx="220" cy="540" r="14"/></g>
						<g class="hs" tabindex="0"><title>Estimate prokaryotic bin completeness and contamination.</title><circle cx="220" cy="615" r="14"/></g>
						<g class="hs" tabindex="0"><title>Assign taxonomy to prokaryotic bins.</title><circle cx="220" cy="695" r="14"/></g>

						<g class="hs" tabindex="0"><title>Classify reads taxonomically with k-mer matching.</title><circle cx="635" cy="465" r="14"/></g>
						<g class="hs" tabindex="0"><title>Classify reads taxonomically using genome-length-normalized abundance estimates.</title><circle cx="635" cy="540" r="14"/></g>
					</svg>
				</div>
			{% elif workflow_diagram and workflow_diagram.nodes %}
				<div class="tag-list workflow-legend">
					{% for cat in workflow_diagram.legend %}
					<span class="tag"><span class="legend-swatch" style="background: {{ cat.color }};"></span>{{ cat.label }}</span>
					{% endfor %}
				</div>
				<div class="workflow-svg-wrap">
					<svg class="workflow-svg" viewBox="0 0 1000 520" role="img"
						   aria-label="Interactive gaia pipeline workflow diagram. Hover or focus each tool node for details.">
						{% for edge in workflow_diagram.edges %}
						<line class="wf-edge" x1="{{ edge.x1 * 12 }}" y1="{{ edge.y1 * 5 }}"
						      x2="{{ edge.x2 * 12 }}" y2="{{ edge.y2 * 5 }}" stroke="{{ edge.color }}"/>
						{% endfor %}
						{% for node in workflow_diagram.nodes %}
						<g class="wf-node" tabindex="0" transform="translate({{ node.x * 12 }}, {{ node.y * 5 }})">
						  <title>{{ node.label }}: {{ node.description }}</title>
						  <circle class="wf-hit" r="20"/>
						  <circle class="wf-dot" r="9" stroke="{{ node.color }}"/>
						  <text class="wf-label" y="-16">{{ node.label }}</text>
						  <foreignObject x="-115" y="-96" width="230" height="76" overflow="visible">
						    <div xmlns="http://www.w3.org/1999/xhtml" class="wf-tooltip">
						      <strong>{{ node.label }}</strong>{{ node.description }}
						    </div>
						  </foreignObject>
						</g>
						{% endfor %}
					</svg>
				</div>
			{% else %}
				<div class="empty-state">No workflow overview information was available for embedding.</div>
			{% endif %}
    </div>
  </section>

  {% if assembly_overview.enabled %}
  <section class="section-card" style="margin-top: 22px;">
    <div class="section-kicker">Genome reconstruction</div>
    <h2 class="panel-title h5">
      Assembly overview
      <span class="help-icon">?<span class="help-tooltip">Run-level summary of MetaFlye assembly quality across all samples, collapsed into a single overview instead of per-sample sections to keep the report concise. N50 and related metrics come from MetaQUAST when available, or are otherwise computed directly from the assembly contigs.</span></span>
    </h2>
    {% if assembly_overview.rows %}
    <div class="metrics-grid mb-3">
      <div class="metric">
        <div class="stat-label">Samples assembled</div>
        <div class="stat-value">{{ assembly_overview.samples_assembled }} / {{ assembly_overview.samples_total }}</div>
      </div>
      <div class="metric">
        <div class="stat-label">Total contigs</div>
        <div class="stat-value">{{ assembly_overview.total_contigs }}</div>
      </div>
      <div class="metric">
        <div class="stat-label">Total assembly length (bp)</div>
        <div class="stat-value">{{ "{:,}".format(assembly_overview.total_length) }}</div>
      </div>
      <div class="metric">
        <div class="stat-label">Median N50 (bp)</div>
        <div class="stat-value">
          {% if assembly_overview.median_n50 is not none %}{{ "{:,}".format(assembly_overview.median_n50) }}{% else %}—{% endif %}
        </div>
      </div>
      <div class="metric">
        <div class="stat-label">N50 range (bp)</div>
        <div class="stat-value">
          {% if assembly_overview.min_n50 is not none %}{{ "{:,}".format(assembly_overview.min_n50) }} – {{ "{:,}".format(assembly_overview.max_n50) }}{% else %}—{% endif %}
        </div>
      </div>
    </div>
    <div class="table-responsive">
      <table class="table table-sm align-middle">
        <thead><tr><th>Sample</th><th>Contigs</th><th>Total length (bp)</th><th>N50 (bp)</th><th>Largest contig (bp)</th></tr></thead>
        <tbody>
        {% for row in assembly_overview.rows %}
          <tr>
            <td>{{ row.sample }}</td>
            <td>{{ row.contig_count }}</td>
            <td>{{ row.total_length }}</td>
            <td>{{ row.n50 }}</td>
            <td>{{ row.largest_contig }}</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
    {% else %}
    <div class="empty-state">No assembly statistics were available for this run.</div>
    {% endif %}
  </section>
  {% endif %}

  {% if binning_overview.applicable %}
  <section class="section-card" style="margin-top: 22px;">
    <div class="section-kicker">Genome reconstruction</div>
    <h2 class="panel-title h5">
      Binning overview
      <span class="help-icon">?<span class="help-tooltip">Run-level summary of genome bins recovered per sample, collapsed across all samples instead of shown per sample. Samples for which binning was not performed (disabled, or skipped because the assembly did not pass the post-assembly binning gate) are listed explicitly below.</span></span>
    </h2>
    <div class="metrics-grid mb-3">
      <div class="metric">
        <div class="stat-label">Samples binned</div>
        <div class="stat-value">{{ binning_overview.samples_binned }} / {{ binning_overview.samples_total }}</div>
      </div>
      <div class="metric">
        <div class="stat-label">Total final genomes</div>
        <div class="stat-value">{{ binning_overview.total_final_genomes }}</div>
      </div>
      <div class="metric">
        <div class="stat-label">Prokaryotic bins (high / medium quality)</div>
        <div class="stat-value">{{ binning_overview.high_quality_prok }} / {{ binning_overview.medium_quality_prok }}</div>
      </div>
      <div class="metric">
        <div class="stat-label">Eukaryotic bins with taxonomy</div>
        <div class="stat-value">{{ binning_overview.euk_bins_with_taxonomy }}</div>
      </div>
    </div>
    {% if binning_overview.not_binned_samples %}
    <div class="alert alert-warning" role="alert">
      Binning was not performed for {{ binning_overview.not_binned_samples | length }} sample(s):
      {{ binning_overview.not_binned_samples | join(", ") }}.
      This happens when binning is disabled for the run, or when a sample's assembly did not pass
      the post-assembly binning gate (too few/short contigs).
    </div>
    {% endif %}
    <div class="table-responsive">
      <table class="table table-sm align-middle">
        <thead>
          <tr>
            <th>Sample</th><th>Binned</th><th>Final genomes</th>
            <th>Prok bins</th><th>Euk bins</th>
            <th>High-quality prok</th><th>Medium-quality prok</th>
            <th>Euk bins w/ taxonomy</th>
          </tr>
        </thead>
        <tbody>
        {% for row in binning_overview.rows %}
          <tr>
            <td>{{ row.sample }}</td>
            <td>{{ "Yes" if row.binned else "Not binned" }}</td>
            <td>{{ row.total_final_genomes }}</td>
            <td>{{ row.total_bins_prok }}</td>
            <td>{{ row.total_bins_euk }}</td>
            <td>{{ row.high_quality_prok }}</td>
            <td>{{ row.medium_quality_prok }}</td>
            <td>{{ row.euk_bins_with_taxonomy }}</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
  </section>
  {% endif %}

  {% set host_rows = samples_data | selectattr("host_stats") | list %}
  {% if host_rows %}
  <section class="section-card" style="margin-top: 22px;">
    <div class="section-kicker">Host removal</div>
    <h2 class="panel-title h5">Host removal – all samples</h2>
    <div class="table-responsive">
      <table class="table table-sm align-middle">
        <thead><tr><th>Sample</th><th>Total reads</th><th>Host reads</th><th>Host %</th><th>Non-host reads</th><th>Non-host %</th></tr></thead>
        <tbody>
        {% for sd in samples_data %}
          {% if sd.host_stats %}
          <tr>
            <td>{{ sd.sample }}</td>
            <td>{{ sd.host_stats.total_reads | int }}</td>
            <td>{{ sd.host_stats.host_reads | int }}</td>
            <td>{{ sd.host_stats.host_percentage }}%</td>
            <td>{{ sd.host_stats.non_host_reads | int }}</td>
            <td>{{ sd.host_stats.non_host_percentage }}%</td>
          </tr>
          {% endif %}
        {% endfor %}
        </tbody>
      </table>
    </div>
  </section>
  {% endif %}

  <section class="section-card" style="margin-top: 22px;">
    <div class="section-kicker">Read quality</div>
    <h2 class="panel-title h5">
      NanoPlot metrics – all samples
      <span class="help-icon">?<span class="help-tooltip">Grouped bar charts compare raw and filtered read length and quality metrics across all samples. Higher values for quality and length indicate better sequencing output.</span></span>
    </h2>
    <div id="nanoplot-overview-median-length" class="plot" style="min-height:340px;"></div>
    <div id="nanoplot-overview-n50" class="plot" style="min-height:340px; margin-top:14px;"></div>
    <div id="nanoplot-overview-quality" class="plot" style="min-height:340px; margin-top:14px;"></div>
  </section>

  {% if taxonomy_overview.kraken2.has_data %}
  <section class="section-card" style="margin-top: 22px;">
    <div class="section-kicker">Taxonomic profiling</div>
    <h2 class="panel-title h5">
      Kraken2 – relative abundance by sample
      <span class="help-icon">?<span class="help-tooltip">100% stacked horizontal bar chart showing species relative abundance per sample. Hover a segment to see species name, read count and percentage. All species beyond the top 10 are grouped as "Other".</span></span>
    </h2>
    <div id="taxonomy-kraken2-overview" class="plot" style="min-height: {{ [taxonomy_overview.kraken2.samples | length * 50 + 120, 300] | max }}px;"></div>
  </section>
  {% endif %}

  {% if taxonomy_overview.centrifuger.has_data %}
  <section class="section-card" style="margin-top: 22px;">
    <div class="section-kicker">Taxonomic profiling</div>
    <h2 class="panel-title h5">
      Centrifuger – relative abundance by sample
      <span class="help-icon">?<span class="help-tooltip">100% stacked horizontal bar chart showing species relative abundance per sample. Hover a segment to see species name, read count and percentage. All species beyond the top 10 are grouped as "Other".</span></span>
    </h2>
    <div id="taxonomy-centrifuger-overview" class="plot" style="min-height: {{ [taxonomy_overview.centrifuger.samples | length * 50 + 120, 300] | max }}px;"></div>
  </section>
  {% endif %}
    </main>
  </div>
</div>

<script>
  (function() {
    var data = {{ nanoplot_overview | tojson }};
    var samples = data.samples;
    var navy = '#10164f', cyan = '#19b6d4';
    var layout_base = {
      paper_bgcolor: 'rgba(0,0,0,0)',
      plot_bgcolor: 'rgba(0,0,0,0)',
      font: { family: '"Segoe UI", Arial, sans-serif', color: '#1d2840' },
      xaxis: { tickangle: -30 },
      legend: { orientation: 'h', y: -0.25 },
      barmode: 'group',
      margin: { t: 40, b: 80, l: 60, r: 20 }
    };

    function makeBar(divId, title, rawKey, filtKey) {
      if (!document.getElementById(divId)) return;
      var traceRaw = {
        x: samples,
        y: data.raw[rawKey],
        name: 'Raw',
        type: 'bar',
        marker: { color: navy }
      };
      var traceFilt = {
        x: samples,
        y: data.filtered[filtKey],
        name: 'Filtered',
        type: 'bar',
        marker: { color: cyan }
      };
      Plotly.newPlot(divId, [traceRaw, traceFilt], Object.assign({}, layout_base, { title: { text: title } }), { responsive: true, displayModeBar: false });
    }

    makeBar('nanoplot-overview-median-length', 'Median read length (bp)', 'median_read_length', 'median_read_length');
    makeBar('nanoplot-overview-n50',           'Read length N50 (bp)',    'read_length_n50',    'read_length_n50');
    makeBar('nanoplot-overview-quality',       'Median read quality',     'median_read_quality','median_read_quality');
  })();

  (function() {
    var taxData = {{ taxonomy_overview | tojson }};
    var palette = [
      '#4e79a7','#f28e2b','#e15759','#76b7b2','#59a14f',
      '#edc948','#b07aa1','#ff9da7','#9c755f','#bab0ac',
      '#19b6d4','#10164f'
    ];
    var otherColor = '#cccccc';

    function renderTaxonomy(divId, tool) {
      var d = taxData[tool];
      if (!d || !d.has_data) return;
      var el = document.getElementById(divId);
      if (!el) return;

      var species = d.species;
      var samples = d.samples;

      var traces = species.map(function(sp, si) {
        var pcts = [], readCounts = [], texts = [];
        samples.forEach(function(smp) {
          var entry = d.data[smp] && d.data[smp][sp];
          var pct = entry ? entry.percent : 0;
          var reads = entry ? entry.reads : 0;
          pcts.push(pct);
          readCounts.push(reads);
          texts.push(sp + '<br>Reads: ' + reads.toLocaleString() + '<br>' + pct.toFixed(1) + '%');
        });
        return {
          name: sp,
          x: pcts,
          y: samples,
          type: 'bar',
          orientation: 'h',
          marker: { color: sp === 'Other' ? otherColor : palette[si % palette.length] },
          text: texts,
          hovertemplate: '%{text}<extra></extra>',
          textposition: 'none'
        };
      });

      var layout = {
        barmode: 'stack',
        paper_bgcolor: 'rgba(0,0,0,0)',
        plot_bgcolor: 'rgba(0,0,0,0)',
        font: { family: '"Segoe UI", Arial, sans-serif', color: '#1d2840' },
        xaxis: { title: 'Relative abundance (%)', range: [0, 100], ticksuffix: '%' },
        yaxis: { automargin: true },
        legend: { orientation: 'h', y: -0.25, traceorder: 'normal' },
        margin: { t: 20, b: 120, l: 160, r: 20 }
      };
      Plotly.newPlot(divId, traces, layout, { responsive: true, displayModeBar: false });
    }

    renderTaxonomy('taxonomy-kraken2-overview', 'kraken2');
    renderTaxonomy('taxonomy-centrifuger-overview', 'centrifuger');
  })();
</script>
</body>
</html>
