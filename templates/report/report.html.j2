<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>Gaia run report</title>
  <link rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
        crossorigin="anonymous"/>
  {{ plotly_js }}
  <style>
    :root {
      --nv-navy: #10164f;
      --nv-navy-soft: #1a236f;
      --nv-cyan: #19b6d4;
      --nv-cyan-soft: #dff6fb;
      --nv-bg: #f4f7fb;
      --nv-card: #ffffff;
      --nv-text: #1d2840;
      --nv-muted: #67748b;
      --nv-border: #d9e3f0;
      --nv-shadow: 0 18px 45px rgba(16, 22, 79, 0.10);
      --nv-radius: 22px;
    }

    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: linear-gradient(180deg, #eef4fb 0%, var(--nv-bg) 180px);
      color: var(--nv-text);
      font-family: "Segoe UI", Arial, sans-serif;
    }

    .page {
      max-width: 1560px;
      margin: 0 auto;
      padding: 24px;
    }

    .layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 18px;
      align-items: start;
    }

    .hero {
      background: linear-gradient(135deg, var(--nv-navy) 0%, var(--nv-navy-soft) 55%, #26339c 100%);
      color: #fff;
      border-radius: 28px;
      padding: 28px 30px;
      box-shadow: var(--nv-shadow);
      overflow: hidden;
      position: relative;
    }

    .hero::after {
      content: "";
      position: absolute;
      inset: 0;
      background:
        radial-gradient(circle at top right, rgba(255,255,255,0.20), transparent 30%),
        radial-gradient(circle at bottom left, rgba(25,182,212,0.22), transparent 30%);
      pointer-events: none;
    }

    .hero-top,
    .hero-stats,
    .overview-grid,
    .metrics-grid,
    .content-grid {
      display: grid;
      gap: 16px;
    }

    .hero-top {
      grid-template-columns: minmax(0, 1.8fr) minmax(280px, 1fr);
      align-items: end;
      position: relative;
      z-index: 1;
    }

    .brand-chip,
    .tag {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      border-radius: 999px;
      font-weight: 600;
    }

    .brand-chip {
      background: rgba(255,255,255,0.12);
      border: 1px solid rgba(255,255,255,0.18);
      color: #fff;
      padding: 10px 14px;
      margin-bottom: 16px;
      letter-spacing: 0.02em;
    }

    .hero h1 {
      margin: 0 0 10px;
      font-size: clamp(2rem, 3vw, 3rem);
      font-weight: 700;
    }

    .hero p,
    .hero code {
      color: rgba(255,255,255,0.92);
    }

    .hero-summary {
      max-width: 720px;
      line-height: 1.5;
      margin-bottom: 0;
    }

    .hero-stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      position: relative;
      z-index: 1;
    }

    .stat-card,
    .panel,
    .metric,
    .section-card {
      background: var(--nv-card);
      border-radius: var(--nv-radius);
      box-shadow: var(--nv-shadow);
    }

    .stat-card {
      background: rgba(255,255,255,0.12);
      border: 1px solid rgba(255,255,255,0.18);
      padding: 16px 18px;
      min-height: 98px;
    }

    .stat-label {
      font-size: 0.75rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.78);
      margin-bottom: 6px;
    }

    .stat-value {
      font-size: 1.3rem;
      font-weight: 700;
      word-break: break-word;
    }

    .overview-grid {
      grid-template-columns: 0.6fr 1fr;
      grid-template-rows: auto auto;
      margin-top: 22px;
      align-items: start;
      gap: 18px;
    }

    .overview-grid .panel-config {
      grid-column: 1;
      grid-row: 1 / span 2;
    }

    .overview-grid .workflow-card {
      grid-column: 2;
      grid-row: 1;
    }

    .overview-grid .panel-stats {
      grid-column: 2;
      grid-row: 2;
    }

    .panel {
      padding: 22px;
      border: 1px solid var(--nv-border);
    }

    .panel-title,
    .section-title {
      margin: 0 0 12px;
      color: var(--nv-navy);
      font-weight: 700;
    }

    .panel-subtitle,
    .muted {
      color: var(--nv-muted);
    }

    .tag-list {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .tag {
      background: var(--nv-cyan-soft);
      color: var(--nv-navy);
      border: 1px solid rgba(25,182,212,0.20);
      padding: 8px 12px;
      text-decoration: none;
    }

    .workflow-card img {
      width: 100%;
      border-radius: 18px;
      border: 1px solid var(--nv-border);
      background: #fff;
    }

	.workflow-image-wrap {
	  position: relative;
	  width: 100%;
	  border-radius: 18px;
	  border: 1px solid var(--nv-border);
	  background: #fff;
	  overflow: hidden;
	}

	.workflow-base {
	  display: block;
	  width: 100%;
	  height: auto;
	  border: 0;          /* override generic .workflow-card img border */
	  border-radius: 0;   /* keep wrapper as the rounded border */
	}

	.workflow-hotspots {
	  position: absolute;
	  inset: 0;
	  width: 100%;
	  height: 100%;
	  pointer-events: none; /* let only hotspots receive events */
	}

	.workflow-hotspots .hs {
	  pointer-events: auto;
	  cursor: pointer;
	}

	.workflow-hotspots .hs circle {
	  fill: rgba(25, 182, 212, 0.18);
	  stroke: #10164f;
	  stroke-width: 2;
	}

	.workflow-hotspots .hs:hover circle,
	.workflow-hotspots .hs:focus circle,
	.workflow-hotspots .hs:focus-visible circle {
	  fill: rgba(25, 182, 212, 0.32);
	  stroke: #19b6d4;
	  stroke-width: 3;
	}

	.workflow-hotspots .hs:focus {
	  outline: none;
	}

    /* Interactive workflow diagram (inline SVG, see report.html.j2 +
       render_report.py WORKFLOW_NODES/WORKFLOW_EDGES for the underlying
       data). Hover/focus a tool node to reveal its tooltip. */
    .workflow-legend {
      margin-bottom: 14px;
    }

    .workflow-legend .tag {
      display: inline-flex;
      align-items: center;
      gap: 7px;
    }

    .workflow-legend .legend-swatch {
      width: 11px;
      height: 11px;
      border-radius: 50%;
      flex: 0 0 auto;
      display: inline-block;
    }

    .workflow-svg-wrap {
      width: 100%;
      border-radius: 18px;
      border: 1px solid var(--nv-border);
      background: #fff;
      padding: 6px;
    }

    .workflow-svg {
      width: 100%;
      height: auto;
      display: block;
    }

    .wf-edge {
      fill: none;
      stroke-width: 3;
      stroke-linecap: round;
      opacity: 0.55;
    }

    .wf-node {
      cursor: pointer;
    }

    .wf-node circle.wf-hit {
      fill: transparent;
    }

    .wf-node circle.wf-dot {
      stroke-width: 3;
      fill: #fff;
      transition: filter 0.15s ease, stroke-width 0.15s ease;
    }

    .wf-node:hover circle.wf-dot,
    .wf-node:focus circle.wf-dot,
    .wf-node:focus-visible circle.wf-dot {
      stroke-width: 4;
      filter: drop-shadow(0 2px 6px rgba(16, 22, 79, 0.35));
    }

    .wf-node:focus {
      outline: none;
    }

    .wf-label {
      font-size: 12px;
      fill: var(--nv-text);
      text-anchor: middle;
      pointer-events: none;
    }

    .wf-tooltip {
      display: none;
      background: var(--nv-navy);
      color: #fff;
      font-size: 0.78rem;
      font-weight: 400;
      line-height: 1.45;
      padding: 8px 12px;
      border-radius: 10px;
      box-shadow: 0 4px 18px rgba(16, 22, 79, 0.22);
      pointer-events: none;
    }

    .wf-tooltip strong {
      display: block;
      margin-bottom: 3px;
      color: #fff;
    }

    .wf-node:hover .wf-tooltip,
    .wf-node:focus .wf-tooltip,
    .wf-node:focus-visible .wf-tooltip {
      display: block;
    }

    .metrics-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .metrics-grid.dense {
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    }

    .metric {
      padding: 16px 18px;
      border: 1px solid var(--nv-border);
    }

    .metric .stat-label {
      color: var(--nv-muted);
    }

    .metric .stat-value {
      color: var(--nv-navy);
      font-size: 1rem;
    }

    .content-grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      margin-top: 18px;
    }

    .section-card {
      padding: 22px;
      border: 1px solid var(--nv-border);
      grid-column: span 12;
    }

    .section-card.split {
      grid-column: span 6;
    }

    .section-kicker {
      display: inline-block;
      margin-bottom: 8px;
      font-size: 0.75rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--nv-cyan);
      font-weight: 700;
    }

    .meta-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 14px;
    }

    .meta-item {
      padding: 14px;
      border-radius: 16px;
      background: #f8fbff;
      border: 1px solid var(--nv-border);
    }

    .meta-item strong {
      display: block;
      color: var(--nv-muted);
      font-size: 0.85rem;
      margin-bottom: 4px;
      font-weight: 600;
    }

    .plot {
      width: 100%;
      min-height: 320px;
    }

    .table {
      margin-bottom: 0;
      --bs-table-bg: transparent;
    }

    .table thead th {
      color: var(--nv-navy);
      background: #f6fbff;
      border-bottom-width: 1px;
      font-size: 0.85rem;
    }

    .table td,
    .table th {
      vertical-align: middle;
      border-color: var(--nv-border);
    }

    .empty-state {
      padding: 18px;
      border-radius: 18px;
      background: #f8fbff;
      color: var(--nv-muted);
      border: 1px dashed var(--nv-border);
    }

    /* Tooltip help icon */
    .help-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background: var(--nv-cyan-soft);
      border: 1px solid rgba(25,182,212,0.35);
      color: var(--nv-navy);
      font-size: 0.68rem;
      font-weight: 700;
      cursor: default;
      position: relative;
      top: -1px;
      margin-left: 7px;
      vertical-align: middle;
      user-select: none;
    }

    .help-icon .help-tooltip {
      display: none;
      position: absolute;
      left: 50%;
      bottom: calc(100% + 6px);
      transform: translateX(-50%);
      background: var(--nv-navy);
      color: #fff;
      font-size: 0.78rem;
      font-weight: 400;
      line-height: 1.45;
      padding: 8px 12px;
      border-radius: 10px;
      white-space: normal;
      width: 240px;
      z-index: 999;
      box-shadow: 0 4px 18px rgba(16,22,79,0.22);
      pointer-events: none;
    }

    .help-icon:hover .help-tooltip {
      display: block;
    }

    /* General Statistics section: compact per-sample host-removal rings */
    .genstats-grid {
      display: grid;
      grid-template-columns: minmax(220px, 1fr) 2fr;
      gap: 20px;
      align-items: start;
    }

    .ring-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
    }

    .ring-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 62px;
    }

    .ring-circle {
      position: relative;
      width: 54px;
      height: 54px;
      border-radius: 50%;
    }

    .ring-circle::after {
      content: "";
      position: absolute;
      inset: 8px;
      border-radius: 50%;
      background: var(--nv-card);
      z-index: 0;
    }

    .ring-circle.ring-empty {
      background: repeating-conic-gradient(#e3e9f2 0deg 30deg, #eef2f8 30deg 60deg);
    }

    .ring-inner {
      position: absolute;
      inset: 0;
      z-index: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.62rem;
      font-weight: 700;
      color: var(--nv-navy);
      text-align: center;
    }

    .ring-label {
      margin-top: 6px;
      font-size: 0.7rem;
      color: var(--nv-muted);
      text-align: center;
      word-break: break-word;
      max-width: 100%;
    }

    .ring-legend {
      display: flex;
      gap: 14px;
      font-size: 0.78rem;
      color: var(--nv-muted);
      margin-bottom: 12px;
    }

    .ring-legend .legend-swatch {
      width: 10px;
      height: 10px;
    }

    .taxa-bar-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .taxa-bar-row {
      display: grid;
      grid-template-columns: minmax(120px, 1fr) 3fr auto;
      align-items: center;
      gap: 10px;
      font-size: 0.82rem;
    }

    .taxa-bar-track {
      background: #eef2f8;
      border-radius: 999px;
      height: 10px;
      overflow: hidden;
    }

    .taxa-bar-fill {
      background: linear-gradient(90deg, var(--nv-cyan) 0%, var(--nv-navy-soft) 100%);
      height: 100%;
      border-radius: 999px;
    }

    /* NanoPlot metrics: very thin horizontal bars (raw vs filtered per sample) */
    .np-groups {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 18px;
    }

    .np-bar-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .np-bar-row {
      display: grid;
      grid-template-columns: minmax(90px, 1fr) 3fr minmax(120px, auto);
      align-items: center;
      gap: 10px;
      font-size: 0.78rem;
    }

    .np-bar-sample {
      word-break: break-word;
    }

    .np-bar-tracks {
      display: flex;
      flex-direction: column;
      gap: 3px;
    }

    .np-bar-track {
      position: relative;
      background: #eef2f8;
      border-radius: 999px;
      height: 4px;
    }

    .np-bar-fill {
      height: 100%;
      border-radius: 999px;
    }

    .np-bar-raw {
      background: var(--nv-navy-soft);
    }

    .np-bar-filtered {
      background: var(--nv-cyan);
    }

    .np-bar-marker {
      position: absolute;
      top: -2px;
      bottom: -2px;
      width: 0;
      border-left: 1px dashed var(--nv-muted);
    }

    .np-bar-values {
      color: var(--nv-muted);
      white-space: nowrap;
      text-align: right;
    }

    @media (max-width: 1080px) {
      .layout {
        grid-template-columns: 1fr;
      }
      .hero-top,
      .overview-grid {
        grid-template-columns: 1fr;
      }

      .overview-grid .panel-config,
      .overview-grid .workflow-card,
      .overview-grid .panel-stats {
        grid-column: 1;
        grid-row: auto;
      }

      .section-card.split {
        grid-column: span 12;
      }

      .genstats-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 768px) {
      .page {
        padding: 14px;
      }

      .hero,
      .panel,
      .section-card {
        padding: 18px;
      }

      .hero-stats,
      .metrics-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>
<div class="page">
  <div class="layout">
    <main>
  <header class="hero">
    <div class="hero-top">
      <div>
        <div class="brand-chip">Gaia &middot; analysis pipeline for long-read shotgun metagenomics</div>
        <h1>Metagenomics run report</h1>
        <p class="hero-summary">
          A summarised overview of preprocessing, host removal, taxonomic profiling, and genome
          reconstruction for <code>{{ samples | length }}</code> sample(s).
        </p>
      </div>
      <div class="hero-stats">
        <div class="stat-card">
          <div class="stat-label">Run mode</div>
          <div class="stat-value">{{ run_mode }}</div>
        </div>
        <div class="stat-card">
          <div class="stat-label">Generated</div>
          <div class="stat-value">{{ generated_at }}</div>
        </div>
        <div class="stat-card">
          <div class="stat-label">Samples</div>
          <div class="stat-value">{{ samples | length }}</div>
        </div>
      </div>
    </div>
  </header>

  <section class="overview-grid">
    <div class="panel panel-config">
      <h2 class="panel-title h5">Run configuration</h2>
      <div class="tag-list mb-3">
        <span class="tag">{{ "Preprocessing enabled" if preprocessing_enabled else "Preprocessing skipped" }}</span>
        <span class="tag">{{ "Host removal enabled" if host_removal_enabled else "Host removal disabled" }}</span>
        {% if host_ref %}
        <span class="tag">Host reference configured</span>
        {% endif %}
      </div>
      <div class="meta-grid">
        <div class="meta-item">
          <strong>Filtering method</strong>
          <span>{{ filtering_method if preprocessing_enabled else "Not applied" }}</span>
        </div>
        <div class="meta-item">
          <strong>Quality thresholds</strong>
          <span>
            {% if filtering_method == "chopper" %}
              Min length {{ chopper_min_length }} bp &middot; Q{{ chopper_quality }}
            {% else %}
              Min length {{ filtlong_min_length }} bp &middot; keep {{ filtlong_keep_percent }}%
            {% endif %}
          </span>
        </div>
        {% if host_ref %}
        <div class="meta-item">
          <strong>Host reference</strong>
          <span><code>{{ host_ref }}</code></span>
        </div>
        {% endif %}
      </div>
      {% if versions %}
      <h3 class="panel-title h6 mt-4">Tool versions</h3>
      <div class="table-responsive">
        <table class="table table-sm align-middle">
          <thead><tr><th>Tool</th><th>Version</th></tr></thead>
          <tbody>
          {% for tool, ver in versions.items() %}
            <tr><td><code>{{ tool }}</code></td><td>{{ ver }}</td></tr>
          {% endfor %}
          </tbody>
        </table>
      </div>
      {% endif %}
    </div>

    <div class="panel workflow-card">
      <h2 class="panel-title h5">
        Pipeline overview
        <span class="help-icon">?<span class="help-tooltip">Interactive workflow diagram: hover (or tab to and focus) a tool dot to see what it does in the pipeline. Colours group tools by pipeli[...]
      </h2>
			{% if workflow_image %}
				<div style="max-width: 70%; margin: 0 auto;">
					<div class="workflow-image-wrap">
					<img src="{{ workflow_image }}" alt="Pipeline workflow" class="workflow-base"/>

					<svg class="workflow-hotspots" viewBox="0 0 821 821" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Workflow with interactive node hotspots">
						<g class="hs" tabindex="0"><title>Generate quality-control metrics for raw sequencing reads.</title><circle cx="194" cy="260" r="14"/></g>
						<g class="hs" tabindex="0"><title>Align reads to the host reference and process alignment files.</title><circle cx="305" cy="260" r="14"/></g>
						<g class="hs" tabindex="0"><title>Trim/filter reads by quality score and minimum length.</title><circle cx="415" cy="260" r="14"/></g>
						<g class="hs" tabindex="0"><title>Filter reads to retain the highest-quality subset for downstream analysis.</title><circle cx="525" cy="260" r="14"/></g>
						<g class="hs" tabindex="0"><title>Generate quality-control metrics for filtered reads.</title><circle cx="635" cy="260" r="14"/></g>

						<g class="hs" tabindex="0"><title>Estimate read coverage/depth to support assembly and binning.</title><circle cx="415" cy="350" r="14"/></g>
						<g class="hs" tabindex="0"><title>Assemble long reads into contigs.</title><circle cx="525" cy="388" r="14"/></g>
						<g class="hs" tabindex="0"><title>Assess assembly quality statistics.</title><circle cx="470" cy="465" r="14"/></g>

						<g class="hs" tabindex="0"><title>Recover metagenome bins using graph-based binning.</title><circle cx="305" cy="360" r="14"/></g>
						<g class="hs" tabindex="0"><title>Recover metagenome bins using tetranucleotide composition and abundance.</title><circle cx="305" cy="390" r="14"/></g>
						<g class="hs" tabindex="0"><title>Recover metagenome bins using coverage/composition clustering.</title><circle cx="305" cy="420" r="14"/></g>

						<g class="hs" tabindex="0"><title>Refine eukaryotic bins for completeness and quality.</title><circle cx="100" cy="540" r="14"/></g>
						<g class="hs" tabindex="0"><title>Dereplicate and quality-check eukaryotic bins.</title><circle cx="100" cy="615" r="14"/></g>
						<g class="hs" tabindex="0"><title>Assign taxonomy to eukaryotic bins.</title><circle cx="100" cy="695" r="14"/></g>

						<g class="hs" tabindex="0"><title>Merge and refine prokaryotic bins from multiple binning methods.</title><circle cx="220" cy="540" r="14"/></g>
						<g class="hs" tabindex="0"><title>Estimate prokaryotic bin completeness and contamination.</title><circle cx="220" cy="615" r="14"/></g>
						<g class="hs" tabindex="0"><title>Assign taxonomy to prokaryotic bins.</title><circle cx="220" cy="695" r="14"/></g>

						<g class="hs" tabindex="0"><title>Classify reads taxonomically with k-mer matching.</title><circle cx="635" cy="465" r="14"/></g>
						<g class="hs" tabindex="0"><title>Classify reads taxonomically using genome-length-normalized abundance estimates.</title><circle cx="635" cy="540" r="14"/></g>
					</svg>
					</div>
				</div>
			{% elif workflow_diagram and workflow_diagram.nodes %}
				<div class="tag-list workflow-legend">
					{% for cat in workflow_diagram.legend %}
					<span class="tag"><span class="legend-swatch" style="background: {{ cat.color }};"></span>{{ cat.label }}</span>
					{% endfor %}
				</div>
				<div style="max-width: 70%; margin: 0 auto;">
					<div class="workflow-svg-wrap">
					<svg class="workflow-svg" viewBox="0 0 1000 520" role="img"
						   aria-label="Interactive gaia pipeline workflow diagram. Hover or focus each tool node for details.">
						{% for edge in workflow_diagram.edges %}
						<line class="wf-edge" x1="{{ edge.x1 * 12 }}" y1="{{ edge.y1 * 5 }}"
						      x2="{{ edge.x2 * 12 }}" y2="{{ edge.y2 * 5 }}" stroke="{{ edge.color }}"/>
						{% endfor %}
						{% for node in workflow_diagram.nodes %}
						<g class="wf-node" tabindex="0" transform="translate({{ node.x * 12 }}, {{ node.y * 5 }})">
						  <title>{{ node.label }}: {{ node.description }}</title>
						  <circle class="wf-hit" r="20"/>
						  <circle class="wf-dot" r="9" stroke="{{ node.color }}"/>
						  <text class="wf-label" y="-16">{{ node.label }}</text>
						  <foreignObject x="-115" y="-96" width="230" height="76" overflow="visible">
						    <div xmlns="http://www.w3.org/1999/xhtml" class="wf-tooltip">
						      <strong>{{ node.label }}</strong>{{ node.description }}
						    </div>
						  </foreignObject>
						</g>
						{% endfor %}
					</svg>
					</div>
				</div>
			{% else %}
				<div class="empty-state">No workflow overview information was available for embedding.</div>
			{% endif %}
    </div>

    <div class="panel panel-stats">
      <div class="section-kicker">Run overview</div>
      <h2 class="panel-title h5" style="margin-bottom: 10px;">
        General Statistics
        <span class="help-icon">?<span class="help-tooltip">Compact run-level summary: one ring per sample showing the host-removal/retained-read split, alongside run-wide ranges for read N50 and C[...]
      </h2>

      {% if not general_stats.has_any_data %}
      <div class="empty-state">Insufficient data to build a General Statistics summary for this run (host-removal, CheckM2 and taxonomy outputs were all unavailable).</div>
      {% else %}
      <div class="genstats-grid">
        <div>
          <h3 class="panel-title h6" style="margin-bottom: 6px;">Host removal by sample</h3>
          {% if general_stats.host_removal_available %}
          <div class="ring-legend">
            <span class="tag"><span class="legend-swatch" style="background: var(--nv-navy-soft);"></span>Host</span>
            <span class="tag"><span class="legend-swatch" style="background: var(--nv-cyan);"></span>Retained (non-host)</span>
          </div>
          <div class="ring-grid">
            {% for r in general_stats.rings %}
            <div class="ring-item">
              {% if r.has_ring %}
              <div class="ring-circle" title="{{ r.sample }}: {{ r.non_host_percentage }}% retained, {{ r.host_percentage }}% host"
                   style="background: conic-gradient(var(--nv-cyan) 0% {{ r.non_host_percentage }}%, var(--nv-navy-soft) {{ r.non_host_percentage }}% 100%);">
                <div class="ring-inner">{{ r.non_host_percentage }}%</div>
              </div>
              {% else %}
              <div class="ring-circle ring-empty" title="{{ r.sample }}: host-removal stats unavailable">
                <div class="ring-inner">—</div>
              </div>
              {% endif %}
              <div class="ring-label">{{ r.sample }}</div>
            </div>
            {% endfor %}
          </div>
          {% else %}
          <div class="empty-state">Host read removal statistics unavailable for this run.</div>
          {% endif %}
        </div>

        <div>
          <h3 class="panel-title h6" style="margin-bottom: 6px;">Across all samples</h3>
          <div class="metrics-grid dense mb-3">
            <div class="metric">
              <div class="stat-label">Read N50 (bp)</div>
              <div class="stat-value">{{ general_stats.n50_range }}</div>
            </div>
            <div class="metric">
              <div class="stat-label">Predicted completeness (CheckM2)</div>
              <div class="stat-value">{{ general_stats.completeness_range if general_stats.checkm2_available else "—" }}</div>
            </div>
            <div class="metric">
              <div class="stat-label">Predicted contamination (CheckM2)</div>
              <div class="stat-value">{{ general_stats.contamination_range if general_stats.checkm2_available else "—" }}</div>
            </div>
          </div>
          {% if not general_stats.checkm2_available %}
          <div class="empty-state">CheckM2 statistics unavailable for this run.</div>
          {% endif %}

          <h3 class="panel-title h6" style="margin: 16px 0 6px;">Top taxa (all samples)</h3>
          {% if general_stats.top_taxa.available %}
          <div class="taxa-bar-list">
            {% for item in general_stats.top_taxa.taxa %}
            <div class="taxa-bar-row">
              <span><em>{{ item.name }}</em></span>
              <div class="taxa-bar-track"><div class="taxa-bar-fill" style="width: {{ item.percent }}%;"></div></div>
              <span>{{ item.percent }}%</span>
            </div>
            {% endfor %}
          </div>
          <p class="muted" style="font-size: 0.78rem; margin-top: 6px;">Source: {{ general_stats.top_taxa.tool }}, aggregated across all samples.</p>
          {% else %}
          <div class="empty-state">No taxonomic profiling data was available for this run.</div>
          {% endif %}
        </div>
      </div>
      {% endif %}
    </div>
  </section>

  <section class="section-card" style="margin-top: 22px;">
    <div class="section-kicker">Run overview</div>
    <h2 class="panel-title h5">
      Assembly overview
      <span class="help-icon">?<span class="help-tooltip">Run-level assembly quality summary: samples with successful assembly, total contig counts, and median N50 across samples. Per-sample[...]
    </h2>
    {% if assembly_overview.enabled %}
      {% if assembly_overview.rows %}
      <div class="table-responsive">
        <table class="table table-sm align-middle">
          <thead>
            <tr>
              <th>Sample</th>
              <th>Contig count</th>
              <th>Total length</th>
              <th>N50</th>
              <th>Largest contig</th>
            </tr>
          </thead>
          <tbody>
          {% for row in assembly_overview.rows %}
            <tr>
              <td>{{ row.sample }}</td>
              <td>{{ row.contig_count }}</td>
              <td>{{ row.total_length }}</td>
              <td>{{ row.n50 }}</td>
              <td>{{ row.largest_contig }}</td>
            </tr>
          {% endfor %}
          </tbody>
        </table>
      </div>
      {% else %}
      <div class="empty-state">No assembly data was available for this run.</div>
      {% endif %}
    {% else %}
    <div class="empty-state">Assembly was not run for this pipeline execution.</div>
    {% endif %}
  </section>

  <section class="section-card" style="margin-top: 18px;">
    <div class="section-kicker">Run overview</div>
    <h2 class="panel-title h5">
      Binning overview
      <span class="help-icon">?<span class="help-tooltip">Genome recovery summary: per-sample binning results (final genome counts and quality estimates), collapsed across samples. Samples[...]
    </h2>
    {% if binning_overview.enabled %}
      {% if binning_overview.applicable %}
        {% if binning_overview.not_binned_samples %}
        <div class="empty-state" style="margin-bottom: 16px;">
          No binning results for: <code>{{ binning_overview.not_binned_samples | join(", ") }}</code> (check that assembly succeeded before binning).
        </div>
        {% endif %}
        {% if binning_overview.rows %}
        <div class="table-responsive">
          <table class="table table-sm align-middle">
            <thead>
              <tr>
                <th>Sample</th>
                <th>Binned</th>
                <th>Final genomes</th>
                <th>Prokaryotic bins</th>
                <th>High-quality prok.</th>
                <th>Medium-quality prok.</th>
                <th>Eukaryotic bins</th>
                <th>Euk. w/ taxonomy</th>
              </tr>
            </thead>
            <tbody>
            {% for row in binning_overview.rows %}
              <tr>
                <td>{{ row.sample }}</td>
                <td>{{ "✓" if row.binned else "✗" }}</td>
                <td>{{ row.total_final_genomes }}</td>
                <td>{{ row.total_bins_prok }}</td>
                <td>{{ row.high_quality_prok }}</td>
                <td>{{ row.medium_quality_prok }}</td>
                <td>{{ row.total_bins_euk }}</td>
                <td>{{ row.euk_bins_with_taxonomy }}</td>
              </tr>
            {% endfor %}
            </tbody>
          </table>
        </div>
        {% else %}
        <div class="empty-state">No binning data was available for this run.</div>
        {% endif %}
      {% else %}
      <div class="empty-state">Binning was not applicable (assembly was skipped for this run).</div>
      {% endif %}
    {% else %}
    <div class="empty-state">Binning was not run for this pipeline execution.</div>
    {% endif %}
  </section>

  <section class="section-card" style="margin-top: 18px;">
    <div class="section-kicker">Read quality</div>
    <h2 class="panel-title h5">
      NanoPlot metrics
      <span class="help-icon">?<span class="help-tooltip">Per-sample read quality and length metrics from NanoPlot, comparing raw and filtered reads. Each metric is drawn as a thin horizontal bar[...]
    </h2>
    {% if nanoplot_overview.samples %}
    <div class="ring-legend">
      <span class="tag"><span class="legend-swatch" style="background: var(--nv-navy-soft);"></span>Raw</span>
      <span class="tag"><span class="legend-swatch" style="background: var(--nv-cyan);"></span>Filtered</span>
    </div>
    <div class="np-groups">
      {% for group in nanoplot_overview.bars %}
      <div class="np-group">
        <h3 class="panel-title h6" style="margin-bottom: 8px;">
          {{ group.label }}
          <span class="muted" style="font-weight: 400; font-size: 0.78rem;">(scale {{ group.scale_min_label }} – {{ group.scale_max_label }})</span>
        </h3>
        {% if group.has_data %}
        <div class="np-bar-list">
          {% for row in group.rows %}
          <div class="np-bar-row">
            <span class="np-bar-sample">{{ row.sample }}</span>
            <div class="np-bar-tracks">
              {% for kind, entry in [("raw", row.raw), ("filtered", row.filtered)] %}
              <div class="np-bar-track" title="{{ row.sample }} – {{ kind }}: {{ entry.label }}">
                <div class="np-bar-fill np-bar-{{ kind }}" style="width: {{ entry.width }}%;"></div>
                {% if group.marker %}
                <div class="np-bar-marker" style="left: {{ group.marker.percent }}%;" title="{{ group.marker.label }}"></div>
                {% endif %}
              </div>
              {% endfor %}
            </div>
            <span class="np-bar-values">{{ row.raw.label }} <span class="muted">&rarr;</span> {{ row.filtered.label }}</span>
          </div>
          {% endfor %}
        </div>
        {% if group.marker %}
        <p class="muted" style="font-size: 0.75rem; margin: 6px 0 0;">Dashed marker: {{ group.marker.label }} reference for Nanopore reads.</p>
        {% endif %}
        {% else %}
        <div class="empty-state">No {{ group.label | lower }} values were available.</div>
        {% endif %}
      </div>
      {% endfor %}
    </div>
    {% else %}
    <div class="empty-state">No NanoPlot metrics were available for this run.</div>
    {% endif %}
    <details style="margin-top: 16px;">
      <summary style="cursor: pointer; font-weight: 600; color: var(--nv-navy); margin-bottom: 12px;">
        Numeric table – Raw vs Filtered – {{ nanoplot_overview.samples | length }} sample(s)
      </summary>
      <div class="table-responsive">
        <table class="table table-sm align-middle">
          <thead>
            <tr>
              <th>Sample</th>
              <th>Median length – Raw</th><th>Median length – Filtered</th>
              <th>N50 – Raw</th><th>N50 – Filtered</th>
              <th>Median Qual – Raw</th><th>Median Qual – Filtered</th>
              <th># Reads – Raw (K)</th><th># Reads – Filtered (K)</th>
              <th>Total Bases – Raw (Mbp)</th><th>Total Bases – Filtered (Mbp)</th>
            </tr>
          </thead>
          <tbody>
          {% for sample in nanoplot_overview.samples %}
            {% set i = loop.index0 %}
            <tr>
              <td>{{ sample }}</td>
              <td>{{ nanoplot_overview.raw.median_read_length[i] if nanoplot_overview.raw.median_read_length[i] is not none else "—" }}</td>
              <td>{{ nanoplot_overview.filtered.median_read_length[i] if nanoplot_overview.filtered.median_read_length[i] is not none else "—" }}</td>
              <td>{{ nanoplot_overview.raw.read_length_n50[i] if nanoplot_overview.raw.read_length_n50[i] is not none else "—" }}</td>
              <td>{{ nanoplot_overview.filtered.read_length_n50[i] if nanoplot_overview.filtered.read_length_n50[i] is not none else "—" }}</td>
              <td>{{ nanoplot_overview.raw.median_read_quality[i] if nanoplot_overview.raw.median_read_quality[i] is not none else "—" }}</td>
              <td>{{ nanoplot_overview.filtered.median_read_quality[i] if nanoplot_overview.filtered.median_read_quality[i] is not none else "—" }}</td>
              <td>{{ nanoplot_overview.raw.number_of_reads[i] if nanoplot_overview.raw.number_of_reads[i] is not none else "—" }}</td>
              <td>{{ nanoplot_overview.filtered.number_of_reads[i] if nanoplot_overview.filtered.number_of_reads[i] is not none else "—" }}</td>
              <td>{{ nanoplot_overview.raw.total_bases[i] if nanoplot_overview.raw.total_bases[i] is not none else "—" }}</td>
              <td>{{ nanoplot_overview.filtered.total_bases[i] if nanoplot_overview.filtered.total_bases[i] is not none else "—" }}</td>
            </tr>
          {% endfor %}
          </tbody>
        </table>
      </div>
    </details>
  </section>

  <section class="section-card" style="margin-top: 18px;">
    <div class="section-kicker">Genome quality</div>
    <h2 class="panel-title h5">
      CheckM2 summary
      <span class="help-icon">?<span class="help-tooltip">Run-level genome quality summary: aggregate ranges for completeness and contamination across all binned genomes. Per-genome details[...]
    </h2>
    {% if checkm2_overview.available %}
      {% if checkm2_overview.genome_count > 0 %}
      <div class="metrics-grid mb-3">
        <div class="metric">
          <div class="stat-label">Total genomes</div>
          <div class="stat-value">{{ checkm2_overview.genome_count }}</div>
        </div>
        <div class="metric">
          <div class="stat-label">Samples with results</div>
          <div class="stat-value">{{ checkm2_overview.sample_count }}</div>
        </div>
        {% for key, val in checkm2_overview.metrics.items() %}
        <div class="metric">
          <div class="stat-label">{{ val.stat.label if val.stat else key | replace('_', ' ') | title }}</div>
          <div class="stat-value">{{ val.range }}</div>
        </div>
        {% endfor %}
      </div>
      {% if checkm2_overview.rows %}
      <h3 class="panel-title h6" style="margin: 14px 0 6px;">Per sample / genome</h3>
      <div class="table-responsive">
        <table class="table table-sm align-middle">
          <thead>
            <tr>
              <th>Sample</th>
              <th>User genome</th>
              <th>Completeness (%)</th>
              <th>Contamination (%)</th>
              <th>Coding density (%)</th>
              <th>Avg gene length (bp)</th>
              <th>Genome size (bp)</th>
              <th>GC (%)</th>
              <th>Total CDS</th>
            </tr>
          </thead>
          <tbody>
          {% for row in checkm2_overview.rows %}
            <tr>
              <td>{{ row.sample }}</td>
              <td><code>{{ row.user_genome }}</code></td>
              <td>{{ row.completeness }}</td>
              <td>{{ row.contamination }}</td>
              <td>{{ row.coding_density }}</td>
              <td>{{ row.average_gene_length }}</td>
              <td>{{ row.genome_size }}</td>
              <td>{{ row.gc_content }}</td>
              <td>{{ row.total_coding_sequences }}</td>
            </tr>
          {% endfor %}
          </tbody>
        </table>
      </div>
      {% endif %}
      {% else %}
      <div class="empty-state">No CheckM2 data was available for this run.</div>
      {% endif %}
    {% else %}
    <div class="empty-state">CheckM2 was not run for this pipeline execution.</div>
    {% endif %}
  </section>

  <section class="section-card" style="margin-top: 18px;">
    <div class="section-kicker">Taxonomy</div>
    <h2 class="panel-title h5">
      GTDB-Tk classification
      <span class="help-icon">?<span class="help-tooltip">Prokaryotic genome taxonomy: GTDB-Tk assignments for all quality-assessed bins, including ANI to closest reference and closest-p[...]
    </h2>
    {% if gtdbtk_rows %}
    <div class="table-responsive">
      <table class="table table-sm align-middle">
        <thead>
          <tr>
            <th>User genome</th>
            <th>Classification</th>
            <th>ANI (%)</th>
            <th>AF (%)</th>
            <th>RED</th>
            <th>Warnings</th>
          </tr>
        </thead>
        <tbody>
        {% for row in gtdbtk_rows %}
          <tr>
            <td><code>{{ row.user_genome }}</code></td>
            <td><em>{{ row.classification }}</em></td>
            <td>{{ row.ani }}</td>
            <td>{{ row.af }}</td>
            <td>{{ row.red }}</td>
            <td><span class="muted" style="font-size: 0.85rem;">{{ row.warnings }}</span></td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
    {% else %}
    <div class="empty-state">No GTDB-Tk taxonomy data was available for this run.</div>
    {% endif %}
  </section>

  {% if taxonomy_overview.kraken2.has_data %}
  <section class="section-card" style="margin-top: 22px;">
    <div class="section-kicker">Taxonomic profiling</div>
    <h2 class="panel-title h5">
      Kraken2 &ndash; relative abundance by sample
      <span class="help-icon">?<span class="help-tooltip">100% stacked horizontal bar chart showing species relative abundance per sample. Hover a segment to see species name, read count and percentage. All species beyond the top 5 are grouped as "Other".</span></span>
    </h2>
    <div id="taxonomy-kraken2-overview" class="plot" style="min-height: {{ [taxonomy_overview.kraken2.samples | length * 50 + 120, 300] | max }}px;"></div>
  </section>
  {% endif %}

  {% if taxonomy_overview.centrifuger.has_data %}
  <section class="section-card" style="margin-top: 22px;">
    <div class="section-kicker">Taxonomic profiling</div>
    <h2 class="panel-title h5">
      Centrifuger &ndash; relative abundance by sample
      <span class="help-icon">?<span class="help-tooltip">100% stacked horizontal bar chart showing species relative abundance per sample. Hover a segment to see species name, read count and percentage. All species beyond the top 5 are grouped as "Other".</span></span>
    </h2>
    <div id="taxonomy-centrifuger-overview" class="plot" style="min-height: {{ [taxonomy_overview.centrifuger.samples | length * 50 + 120, 300] | max }}px;"></div>
  </section>
  {% endif %}

  </main>
  </div>
</div>

<script>
  (function() {
    var taxData = {{ taxonomy_overview | tojson }};
    var palette = [
      '#4e79a7','#f28e2b','#e15759','#76b7b2','#59a14f',
      '#edc948','#b07aa1','#ff9da7','#9c755f','#bab0ac',
      '#19b6d4','#10164f'
    ];
    var otherColor = '#cccccc';

    function renderTaxonomy(divId, tool) {
      var d = taxData[tool];
      if (!d || !d.has_data) return;
      var el = document.getElementById(divId);
      if (!el) return;

      var species = d.species;
      var samples = d.samples;

      var traces = species.map(function(sp, si) {
        var pcts = [], readCounts = [];
        samples.forEach(function(smp) {
          var entry = d.data[smp] && d.data[smp][sp];
          pcts.push(entry ? entry.percent : 0);
          readCounts.push(entry ? entry.reads : 0);
        });
        return {
          name: sp,
          x: pcts,
          y: samples,
          customdata: readCounts,
          type: 'bar',
          orientation: 'h',
          marker: { color: sp === 'Other' ? otherColor : palette[si % palette.length] },
          hovertemplate: sp + ': %{customdata:,} reads (%{x:.1f}%)<extra></extra>',
          textposition: 'none'
        };
      });

      var layout = {
        barmode: 'stack',
        hovermode: 'y unified',
        paper_bgcolor: 'rgba(0,0,0,0)',
        plot_bgcolor: 'rgba(0,0,0,0)',
        font: { family: '"Segoe UI", Arial, sans-serif', color: '#1d2840' },
        xaxis: { title: 'Relative abundance (%)', range: [0, 100], ticksuffix: '%' },
        yaxis: { automargin: true },
        legend: { orientation: 'h', y: -0.25, traceorder: 'normal' },
        margin: { t: 20, b: 120, l: 160, r: 20 },
        hoverlabel: { bgcolor: '#10164f', font: { color: '#fff', size: 12 }, bordercolor: '#19b6d4' }
      };
      Plotly.newPlot(divId, traces, layout, { responsive: true, displayModeBar: false });
    }

    renderTaxonomy('taxonomy-kraken2-overview', 'kraken2');
    renderTaxonomy('taxonomy-centrifuger-overview', 'centrifuger');
  })();
</script>
</body>
</html>
