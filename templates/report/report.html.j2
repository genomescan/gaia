<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>Gaia run report</title>
  <link rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
        crossorigin="anonymous"/>
  <script src="../plotly-2.27.0.min.js"></script>
  <style>
    :root {
      --nv-navy: #10164f;
      --nv-navy-soft: #1a236f;
      --nv-cyan: #19b6d4;
      --nv-cyan-soft: #dff6fb;
      --nv-bg: #f4f7fb;
      --nv-card: #ffffff;
      --nv-text: #1d2840;
      --nv-muted: #67748b;
      --nv-border: #d9e3f0;
      --nv-shadow: 0 18px 45px rgba(16, 22, 79, 0.10);
      --nv-radius: 22px;
    }

    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: linear-gradient(180deg, #eef4fb 0%, var(--nv-bg) 180px);
      color: var(--nv-text);
      font-family: "Segoe UI", Arial, sans-serif;
    }

    .page {
      max-width: 1380px;
      margin: 0 auto;
      padding: 24px;
    }

    .layout {
      display: grid;
      grid-template-columns: 280px minmax(0, 1fr);
      gap: 18px;
      align-items: start;
    }

    .sidebar {
      position: sticky;
      top: 14px;
      background: var(--nv-card);
      border: 1px solid var(--nv-border);
      border-radius: 18px;
      box-shadow: var(--nv-shadow);
      padding: 14px;
      max-height: calc(100vh - 28px);
      overflow: auto;
    }

    .sidebar summary {
      cursor: pointer;
      font-weight: 700;
      color: var(--nv-navy);
      margin-bottom: 10px;
    }

    .sample-jump-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 8px;
    }

    .sample-jump-list a {
      display: block;
      padding: 8px 10px;
      border-radius: 10px;
      text-decoration: none;
      color: var(--nv-navy);
      background: #f8fbff;
      border: 1px solid var(--nv-border);
    }

    .sample-jump-list a:hover {
      background: var(--nv-cyan-soft);
    }

    .hero {
      background: linear-gradient(135deg, var(--nv-navy) 0%, var(--nv-navy-soft) 55%, #26339c 100%);
      color: #fff;
      border-radius: 28px;
      padding: 28px 30px;
      box-shadow: var(--nv-shadow);
      overflow: hidden;
      position: relative;
    }

    .hero::after {
      content: "";
      position: absolute;
      inset: 0;
      background:
        radial-gradient(circle at top right, rgba(255,255,255,0.20), transparent 30%),
        radial-gradient(circle at bottom left, rgba(25,182,212,0.22), transparent 30%);
      pointer-events: none;
    }

    .hero-top,
    .hero-stats,
    .overview-grid,
    .sample-header,
    .metrics-grid,
    .content-grid {
      display: grid;
      gap: 16px;
    }

    .hero-top {
      grid-template-columns: minmax(0, 1.8fr) minmax(280px, 1fr);
      align-items: end;
      position: relative;
      z-index: 1;
    }

    .brand-chip,
    .tag,
    .sample-tab {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      border-radius: 999px;
      font-weight: 600;
    }

    .brand-chip {
      background: rgba(255,255,255,0.12);
      border: 1px solid rgba(255,255,255,0.18);
      color: #fff;
      padding: 10px 14px;
      margin-bottom: 16px;
      letter-spacing: 0.02em;
    }

    .hero h1 {
      margin: 0 0 10px;
      font-size: clamp(2rem, 3vw, 3rem);
      font-weight: 700;
    }

    .hero p,
    .hero code {
      color: rgba(255,255,255,0.92);
    }

    .hero-summary {
      max-width: 720px;
      line-height: 1.5;
      margin-bottom: 0;
    }

    .hero-stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      position: relative;
      z-index: 1;
    }

    .stat-card,
    .panel,
    .metric,
    .section-card {
      background: var(--nv-card);
      border-radius: var(--nv-radius);
      box-shadow: var(--nv-shadow);
    }

    .stat-card {
      background: rgba(255,255,255,0.12);
      border: 1px solid rgba(255,255,255,0.18);
      padding: 16px 18px;
      min-height: 98px;
    }

    .stat-label {
      font-size: 0.75rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.78);
      margin-bottom: 6px;
    }

    .stat-value {
      font-size: 1.3rem;
      font-weight: 700;
      word-break: break-word;
    }

    .overview-grid {
      grid-template-columns: minmax(260px, 360px) minmax(0, 1fr);
      margin-top: 22px;
      align-items: start;
    }

    .panel {
      padding: 22px;
      border: 1px solid var(--nv-border);
    }

    .panel-title,
    .section-title {
      margin: 0 0 12px;
      color: var(--nv-navy);
      font-weight: 700;
    }

    .panel-subtitle,
    .muted {
      color: var(--nv-muted);
    }

    .tag-list,
    .sample-tabs {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .tag,
    .sample-tab {
      background: var(--nv-cyan-soft);
      color: var(--nv-navy);
      border: 1px solid rgba(25,182,212,0.20);
      padding: 8px 12px;
      text-decoration: none;
    }

    .sample-tab {
      background: #fff;
      box-shadow: 0 10px 22px rgba(16, 22, 79, 0.08);
    }

    .workflow-card img {
      width: 100%;
      border-radius: 18px;
      border: 1px solid var(--nv-border);
      background: #fff;
    }

    .sample-nav {
      margin: 26px 0 18px;
    }

    .sample-report {
      margin-top: 28px;
    }

    .sample-header {
      grid-template-columns: minmax(0, 1.4fr) minmax(260px, 0.8fr);
      align-items: start;
      margin-bottom: 16px;
    }

    .sample-banner {
      background: linear-gradient(135deg, var(--nv-navy) 0%, #22308a 100%);
      color: #fff;
      border-radius: 24px;
      padding: 24px 26px;
      box-shadow: var(--nv-shadow);
    }

    .sample-banner h2 {
      margin: 0 0 8px;
      font-size: 1.8rem;
    }

    .sample-banner code {
      color: #fff;
      background: rgba(255,255,255,0.08);
      border-radius: 10px;
      padding: 2px 8px;
    }

    .metrics-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .metric {
      padding: 16px 18px;
      border: 1px solid var(--nv-border);
    }

    .metric .stat-label {
      color: var(--nv-muted);
    }

    .metric .stat-value {
      color: var(--nv-navy);
      font-size: 1rem;
    }

    .content-grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      margin-top: 18px;
    }

    .section-card {
      padding: 22px;
      border: 1px solid var(--nv-border);
      grid-column: span 12;
    }

    .section-card.split {
      grid-column: span 6;
    }

    .section-kicker {
      display: inline-block;
      margin-bottom: 8px;
      font-size: 0.75rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--nv-cyan);
      font-weight: 700;
    }

    .meta-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 14px;
    }

    .meta-item {
      padding: 14px;
      border-radius: 16px;
      background: #f8fbff;
      border: 1px solid var(--nv-border);
    }

    .meta-item strong {
      display: block;
      color: var(--nv-muted);
      font-size: 0.85rem;
      margin-bottom: 4px;
      font-weight: 600;
    }

    .plot {
      width: 100%;
      min-height: 320px;
    }

    .table {
      margin-bottom: 0;
      --bs-table-bg: transparent;
    }

    .table thead th {
      color: var(--nv-navy);
      background: #f6fbff;
      border-bottom-width: 1px;
      font-size: 0.85rem;
    }

    .table td,
    .table th {
      vertical-align: middle;
      border-color: var(--nv-border);
    }

    .empty-state {
      padding: 18px;
      border-radius: 18px;
      background: #f8fbff;
      color: var(--nv-muted);
      border: 1px dashed var(--nv-border);
    }

    @media (max-width: 1080px) {
      .layout {
        grid-template-columns: 1fr;
      }
      .sidebar {
        position: static;
        max-height: none;
      }
      .hero-top,
      .overview-grid,
      .sample-header {
        grid-template-columns: 1fr;
      }

      .section-card.split {
        grid-column: span 12;
      }
    }

    @media (max-width: 768px) {
      .page {
        padding: 14px;
      }

      .hero,
      .sample-banner,
      .panel,
      .section-card {
        padding: 18px;
      }

      .hero-stats,
      .metrics-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>
<div class="page">
  <div class="layout">
    <aside class="sidebar">
      <details>
        <summary>Sample navigator ({{ samples_data | length }})</summary>
        <ul class="sample-jump-list">
          {% for sd in samples_data %}
          <li><a href="#sample-{{ loop.index }}">Sample {{ sd.sample }}</a></li>
          {% endfor %}
        </ul>
      </details>
    </aside>
    <main>
  <header class="hero">
    <div class="hero-top">
      <div>
        <div class="brand-chip">Gaia &middot; analysis pipeline for long-read shotgun metagenomics</div>
        <h1>Metagenomics run report</h1>
        <p class="hero-summary">
          A consolidated overview of preprocessing, host removal, taxonomic profiling, genome reconstruction,
          and final per-sample summaries for <code>{{ samples | length }}</code> sample(s).
        </p>
      </div>
      <div class="hero-stats">
        <div class="stat-card">
          <div class="stat-label">Run mode</div>
          <div class="stat-value">{{ run_mode }}</div>
        </div>
        <div class="stat-card">
          <div class="stat-label">Generated</div>
          <div class="stat-value">{{ generated_at }}</div>
        </div>
        <div class="stat-card">
          <div class="stat-label">Samples</div>
          <div class="stat-value">{{ samples | length }}</div>
        </div>
      </div>
    </div>
  </header>

  <section class="overview-grid">
    <div class="panel">
      <h2 class="panel-title h5">Run configuration</h2>
      <div class="tag-list mb-3">
        <span class="tag">{{ "Preprocessing enabled" if preprocessing_enabled else "Preprocessing skipped" }}</span>
        <span class="tag">{{ "Host removal enabled" if host_removal_enabled else "Host removal disabled" }}</span>
        {% if host_ref %}
        <span class="tag">Host reference configured</span>
        {% endif %}
      </div>
      <div class="meta-grid">
        <div class="meta-item">
          <strong>Filtering method</strong>
          <span>{{ filtering_method if preprocessing_enabled else "Not applied" }}</span>
        </div>
        <div class="meta-item">
          <strong>Quality thresholds</strong>
          <span>
            {% if filtering_method == "chopper" %}
              Min length {{ chopper_min_length }} bp &middot; Q{{ chopper_quality }}
            {% else %}
              Min length {{ filtlong_min_length }} bp &middot; keep {{ filtlong_keep_percent }}%
            {% endif %}
          </span>
        </div>
        {% if host_ref %}
        <div class="meta-item">
          <strong>Host reference</strong>
          <span><code>{{ host_ref }}</code></span>
        </div>
        {% endif %}
      </div>
      {% if versions %}
      <h3 class="panel-title h6 mt-4">Tool versions</h3>
      <div class="table-responsive">
        <table class="table table-sm align-middle">
          <thead><tr><th>Tool</th><th>Version</th></tr></thead>
          <tbody>
          {% for tool, ver in versions.items() %}
            <tr><td><code>{{ tool }}</code></td><td>{{ ver }}</td></tr>
          {% endfor %}
          </tbody>
        </table>
      </div>
      {% endif %}
    </div>

    <div class="panel workflow-card">
      <h2 class="panel-title h5">Pipeline overview</h2>
      {% if workflow_image %}
        <img src="{{ workflow_image }}" alt="Pipeline workflow"/>
      {% else %}
        <div class="empty-state">No workflow overview image was available for embedding.</div>
      {% endif %}
    </div>
  </section>

  <section class="sample-nav">
    <div class="sample-tabs">
      {% for sd in samples_data %}
      <a class="sample-tab" href="#sample-{{ loop.index }}">Sample {{ sd.sample }}</a>
      {% endfor %}
    </div>
  </section>

  {% for sd in samples_data %}
  <article class="sample-report" id="sample-{{ loop.index }}">
    <div class="sample-header">
      <div class="sample-banner">
        <h2>Sample <code>{{ sd.sample }}</code></h2>
        <p class="mb-0">
          {% set taxonomy_tools = [] %}
          {% if sd.kraken2_species %}{% set _ = taxonomy_tools.append("Kraken2") %}{% endif %}
          {% if sd.centrifuger_species %}{% set _ = taxonomy_tools.append("Centrifuger") %}{% endif %}
          {% if taxonomy_tools %}
            Taxonomy available from {{ taxonomy_tools | join(" and ") }}.
          {% else %}
            No taxonomy summaries were generated for this sample.
          {% endif %}
        </p>
      </div>
      <div class="metrics-grid">
        <div class="metric">
          <div class="stat-label">Host removal</div>
          <div class="stat-value">
            {% if sd.host_stats %}
              {{ sd.host_stats.non_host_percentage }}% retained
            {% else %}
              Not reported
            {% endif %}
          </div>
        </div>
        <div class="metric">
          <div class="stat-label">Taxonomy tables</div>
          <div class="stat-value">
            {{ (1 if sd.kraken2_species else 0) + (1 if sd.centrifuger_species else 0) }}
          </div>
        </div>
        <div class="metric">
          <div class="stat-label">Genome summary rows</div>
          <div class="stat-value">{{ sd.genome_summary | length }}</div>
        </div>
        <div class="metric">
          <div class="stat-label">Inventory rows</div>
          <div class="stat-value">{{ sd.genome_inventory | length }}</div>
        </div>
      </div>
    </div>

    <div class="content-grid">
      {% if sd.host_stats and sd.host_plot_data %}
      <section class="section-card split">
        <div class="section-kicker">Host removal</div>
        <h3 class="section-title h5">Read partitioning</h3>
        <div id="host-removal-plot-{{ sd.sample }}" class="plot"></div>
      </section>

      <section class="section-card split">
        <div class="section-kicker">Host removal</div>
        <h3 class="section-title h5">Counts and percentages</h3>
        <div class="table-responsive">
          <table class="table table-sm align-middle">
            <thead><tr><th>Read category</th><th>Count</th><th>Percentage</th></tr></thead>
            <tbody>
              <tr><td>Host</td><td>{{ sd.host_stats.host_reads | int }}</td><td>{{ sd.host_stats.host_percentage }}%</td></tr>
              <tr><td>Non-host</td><td>{{ sd.host_stats.non_host_reads | int }}</td><td>{{ sd.host_stats.non_host_percentage }}%</td></tr>
              <tr class="fw-semibold"><td>Total</td><td>{{ sd.host_stats.total_reads | int }}</td><td>100%</td></tr>
            </tbody>
          </table>
        </div>
      </section>
      {% endif %}

      {% if sd.kraken2_species %}
      <section class="section-card split">
        <div class="section-kicker">Taxonomy</div>
        <h3 class="section-title h5">Kraken2 top species</h3>
        <div class="table-responsive">
          <table class="table table-sm align-middle">
            <thead><tr><th>Species</th><th>Reads</th><th>Percentage (%)</th></tr></thead>
            <tbody>
            {% for row in sd.kraken2_species %}
              <tr><td>{{ row.name }}</td><td>{{ row.reads }}</td><td>{{ row.percent }}</td></tr>
            {% endfor %}
            </tbody>
          </table>
        </div>
      </section>

      <section class="section-card split">
        <div class="section-kicker">Taxonomy</div>
        <h3 class="section-title h5">Kraken2 abundance chart (Top 10)</h3>
        <div id="kraken2-plot-{{ sd.sample }}" class="plot"></div>
      </section>
      {% endif %}

      {% if sd.centrifuger_species %}
      <section class="section-card split">
        <div class="section-kicker">Taxonomy</div>
        <h3 class="section-title h5">Centrifuger top species</h3>
        <div class="table-responsive">
          <table class="table table-sm align-middle">
            <thead><tr><th>Species</th><th>Reads</th><th>Percentage (%)</th></tr></thead>
            <tbody>
            {% for row in sd.centrifuger_species %}
              <tr><td>{{ row.name }}</td><td>{{ row.reads }}</td><td>{{ row.percent }}</td></tr>
            {% endfor %}
            </tbody>
          </table>
        </div>
      </section>

      <section class="section-card split">
        <div class="section-kicker">Taxonomy</div>
        <h3 class="section-title h5">Centrifuger abundance chart (Top 10)</h3>
        <div id="centrifuger-plot-{{ sd.sample }}" class="plot"></div>
      </section>
      {% endif %}

      {% if sd.genome_summary %}
      <section class="section-card">
        <div class="section-kicker">Genome reconstruction</div>
        <h3 class="section-title h5">Genome summary</h3>
        <div class="table-responsive">
          <table class="table table-sm align-middle">
            <thead><tr>{% for col in sd.genome_summary[0].keys() %}<th>{{ col }}</th>{% endfor %}</tr></thead>
            <tbody>{% for row in sd.genome_summary %}<tr>{% for val in row.values() %}<td>{{ val }}</td>{% endfor %}</tr>{% endfor %}</tbody>
          </table>
        </div>
      </section>
      {% endif %}

      {% if sd.genome_inventory %}
      <section class="section-card">
        <div class="section-kicker">Genome reconstruction</div>
        <h3 class="section-title h5">Genome inventory</h3>
        <div class="table-responsive">
          <table class="table table-sm align-middle">
            <thead><tr>{% for col in sd.genome_inventory[0].keys() %}<th>{{ col }}</th>{% endfor %}</tr></thead>
            <tbody>{% for row in sd.genome_inventory %}<tr>{% for val in row.values() %}<td>{{ val }}</td>{% endfor %}</tr>{% endfor %}</tbody>
          </table>
        </div>
      </section>
      {% endif %}

      {% if sd.pipeline_summary %}
      <section class="section-card">
        <div class="section-kicker">Pipeline summary</div>
        <h3 class="section-title h5">Cross-branch synthesis</h3>
        <div class="table-responsive">
          <table class="table table-sm align-middle">
            <thead><tr>{% for col in sd.pipeline_summary[0].keys() %}<th>{{ col }}</th>{% endfor %}</tr></thead>
            <tbody>{% for row in sd.pipeline_summary %}<tr>{% for val in row.values() %}<td>{{ val }}</td>{% endfor %}</tr>{% endfor %}</tbody>
          </table>
        </div>
      </section>
      {% endif %}
    </div>
  </article>
  {% endfor %}
    </main>
  </div>
</div>

<script>
  var plotTheme = {
    paper_bgcolor: 'rgba(0,0,0,0)',
    plot_bgcolor: '#ffffff',
    font: {family: '"Segoe UI", Arial, sans-serif', color: '#1d2840'},
    margin: {l: 70, r: 20, t: 10, b: 45}
  };

  function renderHorizontalBar(containerId, rows, barColor, chartTitle) {
    if (!rows || rows.length === 0) return;
    var el = document.getElementById(containerId);
    if (!el) return;
    var topRows = rows
      .slice()
      .sort(function(a, b) { return Number(b.percent || 0) - Number(a.percent || 0); })
      .slice(0, 10);
    Plotly.newPlot(containerId, [{
      type: 'bar',
      orientation: 'h',
      x: topRows.map(function(r) { return Number(r.reads || 0); }),
      y: topRows.map(function(r) {
        var pct = Number(r.percent || 0);
        return r.name + ' (' + pct.toFixed(2) + '%)';
      }),
      customdata: topRows.map(function(r) { return Number(r.percent || 0); }),
      marker: {color: barColor, line: {color: barColor, width: 1}},
      hovertemplate: '%{y}<br>Reads: %{x:,}<br>Percentage: %{customdata:.2f}%<extra></extra>'
    }], Object.assign({}, plotTheme, {
      title: {text: chartTitle + ' (Top 10)', font: {size: 14, color: '#1d2840'}},
      margin: {l: 230, r: 20, t: 10, b: 45},
      xaxis: {
        title: 'Reads',
        gridcolor: '#d9e3f0',
        zerolinecolor: '#d9e3f0'
      },
      yaxis: {automargin: true, autorange: 'reversed'}
    }), {responsive: true, displayModeBar: false});
  }

  {% for sd in samples_data %}
  (function() {
    var sampleId = {{ sd.sample | tojson }};
    var kraken2Species = {{ sd.kraken2_species | tojson }};
    var centrifugerSpecies = {{ sd.centrifuger_species | tojson }};
    var hostPlotData = {% if sd.host_plot_data %}{{ sd.host_plot_data | tojson }}{% else %}null{% endif %};

    if (hostPlotData) {
      Plotly.newPlot('host-removal-plot-' + sampleId, [{
        type: 'pie',
        labels: hostPlotData.labels,
        values: hostPlotData.values,
        hole: 0.62,
        marker: {colors: ['#10164f', '#19b6d4']},
        textinfo: 'label+percent',
        hovertemplate: '%{label}: %{value:,} (%{percent})<extra></extra>'
      }], Object.assign({}, plotTheme, {
        margin: {l: 20, r: 20, t: 10, b: 10},
        showlegend: true,
        legend: {orientation: 'h', y: -0.1}
      }), {responsive: true, displayModeBar: false});
    }

    renderHorizontalBar('kraken2-plot-' + sampleId, kraken2Species, '#19b6d4', 'Kraken2 abundance');
    renderHorizontalBar('centrifuger-plot-' + sampleId, centrifugerSpecies, '#10164f', 'Centrifuger abundance');
  })();
  {% endfor %}
</script>
</body>
</html>
