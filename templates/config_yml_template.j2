# =============================================================================
# Long-read metagenomics pipeline configuration
# =============================================================================
#
# Author: Theo Bevk
#
# This file controls the main options of the pipeline.
#
# Notes:
# - Paths are relative to the pipeline root directory.
# - Some tools have an "extra" field, which can be used to pass additional
#   parameters/arguments specific to the tool.


# =============================================================================
# 1. Run mode
# =============================================================================
run:
  # Main workflow mode:
  #   "profiling_only"         = run only the read-level taxonomic profiling branch
  #   "assembly_binning_only"  = run only the assembly/genome reconstruction branch
  #   "both"                   = run both branches
  mode: "{{ run_mode }}"

  # Controls whether the profiling branch must finish before the assembly branch
  # starts. If true, profiling is completed first. If false, profiling and
  # assembly steps may run in parallel - might be resource intensive.
  serial_profile_then_assembly: {{ serial_profile_then_assembly | lower }}


# =============================================================================
# 2. Read preprocessing
# =============================================================================
preprocessing:
  # Preprocessing is always performed unless --skip-preprocessing is passed to the run wrapper.
  # The `skip` flag is set automatically by the wrapper.
  skip: {{ preprocessing_skip | lower }}

  # Filtering method: "chopper" (default) or "filtlong"
  filtering_method: "{{ filtering_method }}"


# =============================================================================
# 3. Input samples
# =============================================================================
samples:
  # The pipeline expects matching input FASTQ files in paths.raw_dir.
{% for sample in samples %}
  - {{ sample }}
{% endfor %}

# =============================================================================
# 4. Input and reference paths
# =============================================================================
paths:
  # Optional: directory containing the raw input FASTQ/BAM files.
  # If omitted the pipeline auto-detects supported files (*.fastq, *.fastq.gz,
  # *.fq, *.fq.gz, *.bam) in the current working directory.
  raw_dir: "{{ raw_dir }}"

  # Host reference genome used for optional host read removal during preprocessing.
  # Leave empty ("") to skip host removal entirely.
  host_ref: "{{ host_ref }}"

  # Optional lambda phage reference used for additional read filtering if needed.
  lambda_ref: "{{ lambda_ref }}"

path_scripts: "{{ path_scripts }}"


# =============================================================================
# 5. General tool parameters
# =============================================================================
params:
  # Number of CPU threads assigned to each tool.
  # These values should not exceed the resources available to the Snakemake run
  # or the Slurm job.
  threads:
    host_removal: {{ threads.host_removal }}
    chopper: {{ threads.chopper }}
    filtlong: {{ threads.filtlong }}
    nanoplot: {{ threads.nanoplot }}
    nanoqc: {{ threads.nanoqc }}
    kraken2: {{ threads.kraken2 }}
    centrifuger: {{ threads.centrifuger }}
    centrifuger_quant: {{ threads.centrifuger_quant }}
    metaflye: {{ threads.metaflye }}
    minimap2: {{ threads.minimap2 }}
    samtools: {{ threads.samtools }}
    depth: {{ threads.depth }}
    metabat2: {{ threads.metabat2 }}
    semibin2: {{ threads.semibin2 }}
    comebin: {{ threads.comebin }}
    dastool: {{ threads.dastool }}
    checkm2: {{ threads.checkm2 }}
    gtdbtk: {{ threads.gtdbtk }}
    acr: {{ threads.acr }}
    drep: {{ threads.drep }}
    eukcc: {{ threads.eukcc }}
    bat: {{ threads.bat }}

  # Chopper settings used during read filtering when preprocessing is enabled.
  chopper:
    # Minimum read length to keep.
    min_length: {{ chopper.min_length }}

    # Minimum read quality threshold.
    quality_threshold: {{ chopper.quality_threshold }}

  # Filtlong settings used during read filtering when preprocessing is enabled.
  filtlong:
    # Minimum read length to keep.
    min_length: {{ filtlong.min_length }}

    # Percentage of the best reads to retain, based on Filtlong ranking.
    keep_percent: {{ filtlong.keep_percent }}


# =============================================================================
# 6. Read-level taxonomic profiling branch
# =============================================================================
taxonomy:
  # Taxonomic profilers to run:
  #   ["kraken2"]
  #   ["centrifuger"]
  #   ["kraken2", "centrifuger"]
  tools: {{ taxonomy_tools | tojson }}

  # Kraken2 database directory.
  kraken2_db: "{{ kraken2_db }}"

  # Centrifuger database directory - point directly to db prefix.
  centrifuger_db: "{{ centrifuger_db }}"

  kraken2:
    # Additional Kraken2 arguments.
    extra: "{{ kraken2_extra }}"

  centrifuger:
    # Additional Centrifuger classification arguments.
    extra: "{{ centrifuger_extra }}"

    quant:
      # Additional Centrifuger abundance quantification arguments.
      extra: "{{ centrifuger_quant_extra }}"


# =============================================================================
# 7. Assembly
# =============================================================================
assembly:
  executable: "{{ assembly_executable }}"

  # Flye read type.
  # "--nano-raw", "--nano-hq",...
  read_type: "{{ assembly_read_type }}"

  # Additional arguments.
  extra: "{{ assembly_extra }}"

  # Post-assembly binning gate: an assembly must have at least
  # min_contigs_for_binning contigs of at least min_contig_length_for_binning
  # bp, otherwise all binning-related steps are skipped for that sample
  # instead of failing the workflow.
  min_contigs_for_binning: {{ assembly_min_contigs_for_binning }}
  min_contig_length_for_binning: {{ assembly_min_contig_length_for_binning }}


# =============================================================================
# 8. Assembly quality control
# =============================================================================
assembly_qc:
  # Enable or disable MetaQUAST assembly evaluation.
  metaquast: {{ assembly_qc_metaquast | lower }}

  # Reference genomes for MetaQUAST.
  metaquast_references: "{{ assembly_qc_metaquast_references }}"

  # Additional arguments.
  extra: "{{ assembly_qc_extra }}"


# =============================================================================
# 9. Read mapping and coverage calculation
# =============================================================================
mapping:
  # Enable or disable mapping of reads back to assembled contigs.
  # Mapping is required for coverage-based binning.
  enabled: {{ mapping_enabled | lower }}

  # minimap2 preset.
  preset: "{{ mapping_preset }}"

  # Additional minimap2 arguments.
  extra: "{{ mapping_extra }}"

  # Additional arguments for the contig depth/coverage calculation step.
  depth_extra: "{{ mapping_depth_extra }}"


# =============================================================================
# 10. Binning
# =============================================================================
binning:
  # Enable or disable metagenomic binning.
  enabled: {{ binning_enabled | lower }}

  # Binning tools to run:
  #   "metabat2"
  #   "semibin2"
  #   "comebin"
  #
  # Multiple binners can be selected.
  tools: {{ binning_tools | tojson }}

  semibin2:
    # Additional SemiBin2 arguments.
    extra: "{{ semibin2_extra }}"

  comebin:
    executable: "{{ comebin_executable }}"

    # Number of augmented coverage/embedding views used by COMEBin.
    views: {{ comebin_views }}

    # Additional COMEBin arguments.
    extra: "{{ comebin_extra }}"

  metabat2:
    # Additional MetaBAT2 arguments.
    extra: "{{ metabat2_extra }}"


# =============================================================================
# 11. Bin refinement and genome-level classification
# =============================================================================
refinement:
  # ---------------------------------------------------------------------------
  # 11a. Prokaryotic bin refinement and classification
  # ---------------------------------------------------------------------------
  prok:
    # Refinement with DAS Tool
    dastool: {{ prok_dastool | lower }}

    # Estimate prokaryotic bin quality with CheckM2.
    # Requires dastool: true
    checkm2: {{ prok_checkm2 | lower }}

    # Classify prokaryotic bins with GTDB-Tk.
    # Requires checkm2: true
    gtdbtk: {{ prok_gtdbtk | lower }}

    dastool_params:
      # Search engine used by DAS Tool.
      search_engine: "{{ dastool_search_engine }}"

      # DAS Tool score threshold for selecting refined bins.
      score_threshold: {{ dastool_score_threshold }}

      # Write detailed bin evaluation files.
      write_bin_evals: {{ dastool_write_bin_evals | lower }}

      # Write unbinned contigs to output.
      write_unbinned: {{ dastool_write_unbinned | lower }}

      # DAS Tool db dir inside the container.
      db_directory: "{{ dastool_db_directory }}"

      # Additional DAS Tool arguments.
      extra: "{{ dastool_extra }}"

    checkm2_params:
      # CheckM2 database file.
      db_path: "{{ checkm2_db_path }}"

      # Bin file extension expected by CheckM2.
      extension: "{{ checkm2_extension }}"

      # Additional CheckM2 arguments.
      extra: "{{ checkm2_extra }}"

    gtdbtk_params:
      # GTDB-Tk database directory.
      db_path: "{{ gtdbtk_db_path }}"

      # Optional GTDB-Tk Mash database path.
      mash_db: "{{ gtdbtk_mash_db }}"

      # Additional GTDB-Tk arguments.
      extra: "{{ gtdbtk_extra }}"


  # ---------------------------------------------------------------------------
  # 11b. Eukaryotic bin refinement and classification
  # ---------------------------------------------------------------------------
  euk:
    # Refinement with ACR.
    acr: {{ euk_acr | lower }}

    # Dereplicate or compare refined eukaryotic bins with dRep.
    drep: {{ euk_drep | lower }}

    # Estimate eukaryotic bin quality with EukCC.
    eukcc: {{ euk_eukcc | lower }}

    # Classify eukaryotic bins with BAT/CAT.
    bat: {{ euk_bat | lower }}

    acr_params:
      # ACR database directory.
      db_path: "{{ acr_db_path }}"

      # ACR target setting.
      # "Both" - refinement of prok and euk candidates.
      target: "{{ acr_target }}"

      # Coverage input provided in JGI depth format.
      from_jgi_cov: "{{ acr_from_jgi_cov }}"

      # GeneMark-ES/ET related steps are run.
      run_gmesEuk: "{{ acr_run_gmesEuk }}"

      # Minimum completeness threshold.
      comp: {{ acr_comp }}

      # Additional ACR arguments.
      extra: "{{ acr_extra }}"

    drep_params:
      # Additional dRep arguments.
      extra: "{{ drep_extra }}"

    eukcc_params:
      # EukCC database directory.
      db_path: "{{ eukcc_db_path }}"

      # Additional EukCC arguments.
      extra: "{{ eukcc_extra }}"

    bat_params:
      executable: "{{ bat_executable }}"

      # BAT database directory.
      db_path: "{{ bat_db_path }}"

      # BAT taxonomy directory.
      taxonomy_path: "{{ bat_taxonomy_path }}"

      # Bin file suffix.
      bin_suffix: "{{ bat_bin_suffix }}"

      # Additional BAT arguments.
      extra: "{{ bat_extra }}"


# =============================================================================
# 12. Containers
# =============================================================================
containers:
  preprocessing_qc: "{{ containers.preprocessing_qc }}"
  taxonomy: "{{ containers.taxonomy }}"
  assembly: "{{ containers.assembly }}"
  metabat2: "{{ containers.metabat2 }}"
  semibin2: "{{ containers.semibin2 }}"
  comebin: "{{ containers.comebin }}"
  prok: "{{ containers.prok }}"
  euk: "{{ containers.euk }}"
