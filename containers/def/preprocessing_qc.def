Bootstrap: docker
From: ubuntu:22.04

%labels
    Description "Preprocessing and QC tools"

%help
    Tools:
      - minimap2
      - samtools
      - filtlong
      - chopper
      - NanoPlot
      - nanoQC

%environment
    export LC_ALL=C
    export LANG=C
    export PATH=/opt/conda/envs/preproc_core/bin:/opt/conda/envs/preproc_chopper/bin:/opt/conda/bin:$PATH

%post
    set -e
    export DEBIAN_FRONTEND=noninteractive

    apt-get update && apt-get install -y --no-install-recommends \
        wget curl git bzip2 ca-certificates build-essential gzip unzip \
        autoconf automake make pkg-config \
        zlib1g-dev libbz2-dev liblzma-dev libcurl4-openssl-dev \
        libncurses5-dev libncursesw5-dev \
        python3 python3-pip
    rm -rf /var/lib/apt/lists/*

    wget -qO /tmp/miniforge.sh \
      https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-x86_64.sh
    bash /tmp/miniforge.sh -b -p /opt/conda
    rm -f /tmp/miniforge.sh
    export PATH=/opt/conda/bin:$PATH

    conda config --system --add channels conda-forge
    conda config --system --add channels bioconda
    conda config --system --set channel_priority strict

    conda create -y -n preproc_core python=3.10 minimap2 filtlong pip unzip
    /opt/conda/envs/preproc_core/bin/pip install --no-cache-dir NanoPlot

    cd /tmp
    wget -qO nanoQC-master.zip https://github.com/wdecoster/nanoQC/archive/refs/heads/master.zip
    unzip -q nanoQC-master.zip
    /opt/conda/envs/preproc_core/bin/pip install --no-cache-dir /tmp/nanoQC-master
    rm -rf /tmp/nanoQC-master /tmp/nanoQC-master.zip
    
    conda create -y -n preproc_chopper python=3.10 chopper

    cd /tmp
    wget -q https://github.com/samtools/samtools/releases/download/1.22.2/samtools-1.22.2.tar.bz2
    tar -xjf samtools-1.22.2.tar.bz2
    cd samtools-1.22.2
    ./configure --prefix=/usr/local
    make -j"$(nproc)"
    make install

    conda clean -afy
    rm -rf /tmp/samtools-1.22.2 /tmp/samtools-1.22.2.tar.bz2

%runscript
    export PATH=/usr/local/bin:/opt/conda/envs/preproc_core/bin:/opt/conda/envs/preproc_chopper/bin:/opt/conda/bin:$PATH
    exec "$@"
