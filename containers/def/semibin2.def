Bootstrap: docker
From: ubuntu:22.04

%labels
    Author your_name
    Description "SemiBin2 container"

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive

    apt-get update
    apt-get install -y --no-install-recommends \
        wget curl git bzip2 ca-certificates gzip unzip file locales \
        python3 python3-pip
    rm -rf /var/lib/apt/lists/*

    wget -qO /tmp/miniforge.sh \
        https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-x86_64.sh
    bash /tmp/miniforge.sh -b -p /opt/conda
    rm -f /tmp/miniforge.sh

    export PATH=/opt/conda/bin:$PATH

    conda config --system --remove-key channels || true
    conda config --system --add channels conda-forge
    conda config --system --add channels bioconda
    conda config --system --set channel_priority strict

    conda create -y -n semibin \
        --override-channels \
        -c conda-forge -c bioconda \
        python=3.10 \
        semibin

    conda clean -afy

%environment
    export LC_ALL=C
    export LANG=C
    export PATH=/opt/conda/envs/semibin/bin:/opt/conda/bin:$PATH

%runscript
    exec /bin/bash "$@"

%test
    . /opt/conda/etc/profile.d/conda.sh
    conda activate semibin
    which SemiBin2
    SemiBin2 --help >/dev/null
