Bootstrap: docker
From: ubuntu:22.04

%labels
    Description "Assembly tools for long-read metagenomics: MetaFlye + MetaQUAST"

%help
    Tools included:
      - flye
      - metaquast.py
      - quast.py

%environment
    export LC_ALL=C
    export LANG=C
    export PATH=/opt/conda/envs/assembly/bin:/opt/conda/bin:$PATH

%post
    set -e
    export DEBIAN_FRONTEND=noninteractive

    apt-get update && apt-get install -y --no-install-recommends \
        wget \
        curl \
        git \
        bzip2 \
        ca-certificates \
        gzip \
        unzip \
        file \
        locales \
        python3 \
        python3-pip
    rm -rf /var/lib/apt/lists/*

    wget -qO /tmp/miniforge.sh \
      https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-x86_64.sh
    bash /tmp/miniforge.sh -b -p /opt/conda
    rm -f /tmp/miniforge.sh

    export PATH=/opt/conda/bin:$PATH

    conda config --system --remove-key channels || true
    conda config --system --add channels bioconda
    conda config --system --add channels conda-forge
    conda config --system --set channel_priority strict

    conda create -y -n assembly \
        --override-channels \
        -c conda-forge \
        -c bioconda \
        python=3.10 \
        flye \
        quast

    conda clean -afy

%test
    export PATH=/opt/conda/envs/assembly/bin:/opt/conda/bin:$PATH
    command -v flye >/dev/null
    command -v quast.py >/dev/null
    command -v metaquast.py >/dev/null

%runscript
    export PATH=/opt/conda/envs/assembly/bin:/opt/conda/bin:$PATH
    exec "$@"
